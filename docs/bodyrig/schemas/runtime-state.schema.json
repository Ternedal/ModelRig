{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/bodyrig/runtime-state-0.1.json",
  "title": "BodyRig runtime state v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "session_id", "sequence", "timestamp_ms", "state", "bodyprint_id", "health"],
  "properties": {
    "type": {"const": "bodyrig.runtime_state"},
    "version": {"const": "0.1"},
    "session_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "state": {"enum": ["idle", "listening", "thinking", "speaking", "waiting_for_tool", "interrupted", "error"]},
    "active_utterance_id": {"type": ["string", "null"]},
    "active_gesture": {"type": ["string", "null"]},
    "bodyprint_id": {"type": "string", "minLength": 1},
    "health": {"enum": ["ok", "degraded", "error"]}
  }
}
