{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/bodyrig/render-frame.schema.json",
  "title": "BodyRig RenderFrame v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "timestamp_ms",
    "state",
    "gesture",
    "gaze_target",
    "gaze_strength",
    "emotion",
    "emotion_intensity",
    "energy",
    "mouth_open",
    "visemes",
    "speech_timing_mode",
    "blink",
    "breath",
    "head_yaw_hint",
    "head_pitch_hint",
    "face_profile_id",
    "face_channels",
    "face_channel_sources",
    "body_motion_profile_id",
    "body_motion_source",
    "head_motion_scale",
    "micro_motion_scale",
    "posture_lean_x",
    "posture_source",
    "resolved_gesture",
    "gesture_resolution_source",
    "dominant_side_hint",
    "gesture_frequency_per_minute"
  ],
  "properties": {
    "type": {"const": "bodyrig.render_frame"},
    "version": {"const": "0.1"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "state": {
      "enum": ["idle", "listening", "thinking", "speaking", "waiting_for_tool", "interrupted", "error"]
    },
    "gesture": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "gaze_target": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "gaze_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "emotion": {"type": "string", "minLength": 1, "maxLength": 160},
    "emotion_intensity": {"type": "number", "minimum": 0, "maximum": 1},
    "energy": {"type": "number", "minimum": 0, "maximum": 1},
    "mouth_open": {"type": "number", "minimum": 0, "maximum": 1},
    "visemes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:+-]+$"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "speech_timing_mode": {"enum": ["audio_envelope", "timed", null]},
    "blink": {"type": "number", "minimum": 0, "maximum": 1},
    "breath": {"type": "number", "minimum": 0, "maximum": 1},
    "head_yaw_hint": {"type": "number", "minimum": -1, "maximum": 1},
    "head_pitch_hint": {"type": "number", "minimum": -1, "maximum": 1},
    "face_profile_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:+-]+$"
    },
    "face_channels": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
          "value": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "face_channel_sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
          "source": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"}
        }
      }
    },
    "body_motion_profile_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:+-]+$"
    },
    "body_motion_source": {"enum": ["generic", "profile"]},
    "head_motion_scale": {"type": "number", "minimum": 0, "maximum": 2},
    "micro_motion_scale": {"type": "number", "minimum": 0, "maximum": 2},
    "posture_lean_x": {"type": "number", "minimum": -1, "maximum": 1},
    "posture_source": {"enum": ["generic", "profile"]},
    "resolved_gesture": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "gesture_resolution_source": {"enum": ["none", "semantic", "explicit_profile", "profile_replay"]},
    "dominant_side_hint": {"enum": ["left", "right", "balanced", null]},
    "gesture_frequency_per_minute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "value"],
      "properties": {
        "present": {"type": "boolean"},
        "value": {"type": "number", "minimum": 0, "maximum": 600}
      }
    }
  }
}
