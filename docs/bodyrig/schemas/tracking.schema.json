{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/bodyrig/tracking-v1.json",
  "title": "BodyRig tracking timeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "coordinate_space",
    "source",
    "backend",
    "frames",
    "coverage",
    "recommendations",
    "production_activation"
  ],
  "properties": {
    "schema": {"const": "bodyrig.tracking/v1"},
    "coordinate_space": {"const": "image_normalized_right_down_depth_relative/v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "permission_assertion", "media"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "permission_assertion": {"type": "string", "minLength": 1, "maxLength": 256},
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codec", "width", "height", "duration_us", "nominal_fps"],
          "properties": {
            "codec": {"type": "string", "minLength": 1, "maxLength": 64},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "duration_us": {"type": "integer", "minimum": 1},
            "nominal_fps": {"type": "number", "minimum": 0.1, "maximum": 1000.0}
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "model_revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "hands", "face"],
      "properties": {
        "body": {"$ref": "#/$defs/coverage"},
        "hands": {"$ref": "#/$defs/coverage"},
        "face": {"$ref": "#/$defs/coverage"}
      }
    },
    "recommendations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["need_more_full_body", "more_visible_hands", "need_clearer_face"]}
    },
    "production_activation": {"const": false}
  },
  "$defs": {
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "confidence"],
      "properties": {
        "x": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "y": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "z": {"type": "number", "minimum": -4.0, "maximum": 4.0},
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Detector visibility/presence when available; null means the backend did not expose a per-landmark confidence signal."
        }
      }
    },
    "body_landmarks": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "nose", "left_eye", "right_eye", "left_ear", "right_ear",
          "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
          "left_wrist", "right_wrist", "left_hip", "right_hip",
          "left_knee", "right_knee", "left_ankle", "right_ankle",
          "left_heel", "right_heel", "left_foot_index", "right_foot_index"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/landmark"}
    },
    "hand_landmarks": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "wrist", "thumb_cmc", "thumb_mcp", "thumb_ip", "thumb_tip",
          "index_mcp", "index_pip", "index_dip", "index_tip",
          "middle_mcp", "middle_pip", "middle_dip", "middle_tip",
          "ring_mcp", "ring_pip", "ring_dip", "ring_tip",
          "pinky_mcp", "pinky_pip", "pinky_dip", "pinky_tip"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/landmark"}
    },
    "face_landmarks": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "nose_tip", "chin", "mouth_left", "mouth_right", "upper_lip", "lower_lip",
          "left_eye_inner", "left_eye_outer", "right_eye_inner", "right_eye_outer",
          "left_brow_inner", "left_brow_outer", "right_brow_inner", "right_brow_outer"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/landmark"}
    },
    "expressions": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "blink_left", "blink_right", "jaw_open", "mouth_smile_left",
          "mouth_smile_right", "mouth_frown_left", "mouth_frown_right",
          "brow_inner_up", "brow_down_left", "brow_down_right"
        ]
      },
      "additionalProperties": {"type": "number", "minimum": 0.0, "maximum": 1.0}
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_us", "body", "left_hand", "right_hand", "face", "expressions"],
      "properties": {
        "timestamp_us": {"type": "integer", "minimum": 0},
        "body": {"$ref": "#/$defs/body_landmarks"},
        "left_hand": {"$ref": "#/$defs/hand_landmarks"},
        "right_hand": {"$ref": "#/$defs/hand_landmarks"},
        "face": {"$ref": "#/$defs/face_landmarks"},
        "expressions": {"$ref": "#/$defs/expressions"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_frames", "total_frames", "coverage", "confidence_frames", "mean_confidence"
      ],
      "properties": {
        "observed_frames": {"type": "integer", "minimum": 0},
        "total_frames": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "confidence_frames": {"type": "integer", "minimum": 0},
        "mean_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    }
  }
}
