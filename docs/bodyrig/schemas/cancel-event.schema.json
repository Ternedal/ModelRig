{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/bodyrig/cancel-event-0.1.json",
  "title": "BodyRig cancel event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "session_id", "sequence", "timestamp_ms", "scope", "reason"],
  "properties": {
    "type": {"const": "bodyrig.cancel"},
    "version": {"const": "0.1"},
    "session_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "scope": {"enum": ["utterance", "gesture", "all"]},
    "utterance_id": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "transition_ms": {"type": "integer", "minimum": 0, "maximum": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "utterance"}}},
      "then": {"required": ["utterance_id"]}
    }
  ]
}
