# ModelRig environment reference. Copy to modelrig.env in the ModelRig root and edit, or set these in your
# shell / service manager. The backend and worker read them from the environment.

# ---- backend (Go) ----
MODELRIG_HOST=0.0.0.0                      # bind address. 0.0.0.0 for LAN/Android. NOT 127.0.0.1.
MODELRIG_PORT=8080
MODELRIG_OLLAMA_URL=http://127.0.0.1:11434 # where Ollama listens
# MODELRIG_OLLAMA_KEY=                       # set (+ point OLLAMA_URL at https://ollama.com) to use Ollama Cloud
MODELRIG_WORKER_URL=http://127.0.0.1:8099  # where the RAG worker listens
MODELRIG_DATA=./modelrig-data.json         # device + pairing store
MODELRIG_PAIRING_TTL=300                    # pairing code lifetime (seconds)
MODELRIG_CLAIM_MAX=10                       # max pair/claim attempts per IP / 5 min
# MODELRIG_ADMIN_KEY=change-me             # if set, pair/start requires X-Admin-Key
# MODELRIG_CONFIG=./config.json            # optional JSON config file
KALIV_AGENT3_ENABLED=1                      # Agent 3 routes exist only when this is 1 -- the appliance wants it on (#753)
KALIV_SCHEDULER_API=0                       # 1 = expose authenticated /api/v1/schedules routes to paired devices
# KALIV_SCHEDULER_APPROVAL_SECRET=          # REQUIRED for scheduled writes: same random 32+ byte value in backend + worker

# ---- worker (Python) ----
MODELRIG_OLLAMA_URL=http://127.0.0.1:11434 # (worker reads the same var)
MODELRIG_EMBED_MODEL=nomic-embed-text
MODELRIG_GEN_MODEL=qwen2.5-coder:7b        # MUST name a model `ollama list` actually shows on THIS rig (e.g. qwen3:14b) -- a mismatch is 'model not found' in the app (#753)
MODELRIG_OLLAMA_TIMEOUT=60
MODELRIG_DB=./modelrig-rag.db
KALIV_TOOLS_ENABLED=1                       # 1 = agent/tool layer on (the appliance wants it on)
KALIV_SCHEDULER=0                           # 1 = start local scheduler runner; API flag above is separate
# KALIV_AGENT3_VALIDATION_REPORT=C:\path\to\validation\agent3-rig-validation-latest.json  # lets the running worker attest its own rig evidence; required for activation readiness = YES

# ---- media executor (G2b; default OFF) ----
# Started by modelrig-supervisor, one process per GPU, only when KALIV_MEDIA_EXECUTOR=1. Leave this whole
# block commented out until the rig qualification pack (#2296) has passed and activation is approved.
# Images only for now. Paths must be absolute; nothing is created. Media is generated in a private work area on the
# internal disk and published on the external volume (Anders, 6 Nov 2026; docs/MEDIA_WORK_AREA.md).
# KALIV_MEDIA_EXECUTOR=1                     # master switch; anything else is off
# KALIV_MEDIA_EXECUTOR_DEVICES=cuda:0        # one executor per entry, e.g. cuda:0,cuda:1
# KALIV_MEDIA_EXECUTOR_PYTHON=C:\Kaliv\media-venv\Scripts\python.exe   # media environment (torch, diffusers), docs/MEDIA_IMAGE_RIG_QUALIFICATION.md §4.1
# KALIV_MEDIA_EXECUTOR_APP_DIR=C:\ModelRig\worker                        # folder that contains app\media_executor_main.py
# KALIV_MEDIA_WORK_ROOT=C:\Kaliv\media-work  # private work area (only this account, SYSTEM, Administrators)
# KALIV_MEDIA_JOB_DB=C:\Kaliv\media-work\state\jobs.sqlite3              # job database, in the work area (prompts blanked 30 days after a job ends)
# KALIV_MEDIA_VOLUME_ROOT=Z:\                # the external publication volume (a mount point, never the system disk)
# KALIV_MEDIA_VOLUME_ID=kaliv-media-z-01      # the id written once into Z:\.kaliv-media-volume (docs/MEDIA_VOLUME.md)
# KALIV_MEDIA_ROOT=Z:\kaliv-media\gallery    # gallery folder on that volume
# KALIV_MEDIA_JOBS_API=1                    # device job and gallery routes (Go and worker read it); off otherwise, 503
# KALIV_MEDIA_INTERNAL_SECRET=<32+ chars>    # server<->worker only, the same in both, never on a device or in a log
# KALIV_MEDIA_PROFILE_DIR=C:\ModelRig\media-profiles
# KALIV_MEDIA_PROFILES_ENABLED=sdxl-base-1-0 # comma-separated profile ids; nothing runs unless listed
# KALIV_GPU_LEASE_DIR=C:\ModelRig\gpu-lease  # absolute, owned by the service account, not writable by others (DACL checked; under C:\ remove inheritance, see docs/MEDIA_GENERATION_PROFILES.md)
# KALIV_GPU_DEVICE_UUIDS=cuda:0=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # from: nvidia-smi --query-gpu=index,uuid --format=csv
# CUDA_DEVICE_ORDER=PCI_BUS_ID               # required so cuda:N means the same GPU everywhere
# HF_HUB_OFFLINE=1                           # required: never a download at run time
# TRANSFORMERS_OFFLINE=1                     # required
# KALIV_MEDIA_IDLE_UNLOAD_S=300              # unload an idle model so the GPU is free for Ollama
# KALIV_MEDIA_TRANSLATE_MODEL=qwen3:4b       # translate every prompt to English with this local Ollama model first (docs/MEDIA_PROMPT_TRANSLATION.md); unset = off
# KALIV_MEDIA_TRANSLATE_URL=http://127.0.0.1:11434  # numeric loopback only (no names), proxies ignored, redirects refused; never the cloud URL
# KALIV_MEDIA_TRANSLATE_TIMEOUT_S=30         # on timeout the original prompt renders
#
# Pictures and video from the chat (the assistant's own tools; needs KALIV_TOOLS_ENABLED=1 and
# KALIV_MEDIA_JOBS_API=1 above, and a running executor). All default-off; the worker reads these
# at start. docs/RIGDAG_MEDIE_I_CHAT.md is the rig-day plan.
# KALIV_IMAGE_TOOL_ENABLED=1                 # offer image_generate in the chat turn
# KALIV_IMAGE_TOOL_PROFILE=realvisxl-4-0     # default picture profile; needed when more than one image profile is enabled
# KALIV_VIDEO_TOOL_ENABLED=1                 # offer video_generate in the chat turn
# KALIV_VIDEO_TOOL_PROFILE=ltx23-t2v-av-gpu1,ltx23-i2v-av-gpu1  # default video profile; with a profile per task (text / picture), list one id per task
#
# Video through a supervised ComfyUI (executor; docs/MEDIA_VIDEO_GENERATION.md, rig steps in
# docs/MEDIA_VIDEO_RIG_QUALIFICATION.md §5-§8). An enabled video profile without these is exit 78.
# KALIV_MEDIA_VIDEO=1                        # the video switch, separate from KALIV_MEDIA_EXECUTOR
# KALIV_COMFY_PYTHON=C:\Kaliv\comfy-venv\Scripts\python.exe   # python of the pinned ComfyUI environment
# KALIV_COMFY_MAIN=C:\Kaliv\ComfyUI\main.py                   # that ComfyUI's main.py
# KALIV_COMFY_DIR=C:\Kaliv\media-work\comfy                   # in the work area; each executor uses cuda<N>\ in it (input, output, temp, user)
# KALIV_COMFY_TEMPLATE_DIR=C:\ModelRig\comfy-templates        # the operator's workflow templates
# KALIV_COMFY_WEIGHTS_CACHE=C:\Kaliv\media-work\comfy\weights-cache.json  # optional: remembers weight hashes, so 40 GB is not re-hashed at every start
# KALIV_COMFY_HOST_MEMORY_GIB=40             # optional, 1..64, default 48: host RAM one ComfyUI may commit before its Job Object stops it. Keep it under the machine's RAM minus what Windows, Ollama and the picture model need (22 Nov 2026: LTX-2.3 ran with 40 on a 64 GB rig)
