# ModelRig environment reference. Copy to modelrig.env in the ModelRig root and edit, or set these in your
# shell / service manager. The backend and worker read them from the environment.

# ---- backend (Go) ----
MODELRIG_HOST=0.0.0.0                      # bind address. 0.0.0.0 for LAN/Android. NOT 127.0.0.1.
MODELRIG_PORT=8080
MODELRIG_OLLAMA_URL=http://127.0.0.1:11434 # where Ollama listens
# MODELRIG_OLLAMA_KEY=                       # set (+ point OLLAMA_URL at https://ollama.com) to use Ollama Cloud
MODELRIG_WORKER_URL=http://127.0.0.1:8099  # where the RAG worker listens
MODELRIG_DATA=./modelrig-data.json         # device + pairing store
MODELRIG_PAIRING_TTL=300                    # pairing code lifetime (seconds)
MODELRIG_CLAIM_MAX=10                       # max pair/claim attempts per IP / 5 min
# MODELRIG_ADMIN_KEY=change-me             # if set, pair/start requires X-Admin-Key
# MODELRIG_CONFIG=./config.json            # optional JSON config file
KALIV_AGENT3_ENABLED=1                      # Agent 3 routes exist only when this is 1 -- the appliance wants it on (#753)
KALIV_SCHEDULER_API=0                       # 1 = expose authenticated /api/v1/schedules routes to paired devices
# KALIV_SCHEDULER_APPROVAL_SECRET=          # REQUIRED for scheduled writes: same random 32+ byte value in backend + worker

# ---- worker (Python) ----
MODELRIG_OLLAMA_URL=http://127.0.0.1:11434 # (worker reads the same var)
MODELRIG_EMBED_MODEL=nomic-embed-text
MODELRIG_GEN_MODEL=qwen2.5-coder:7b        # MUST name a model `ollama list` actually shows on THIS rig (e.g. qwen3:14b) -- a mismatch is 'model not found' in the app (#753)
MODELRIG_OLLAMA_TIMEOUT=60
MODELRIG_DB=./modelrig-rag.db
KALIV_TOOLS_ENABLED=1                       # 1 = agent/tool layer on (the appliance wants it on)
KALIV_SCHEDULER=0                           # 1 = start local scheduler runner; API flag above is separate
# KALIV_AGENT3_VALIDATION_REPORT=C:\path\to\validation\agent3-rig-validation-latest.json  # lets the running worker attest its own rig evidence; required for activation readiness = YES

# ---- media executor (G2b; default OFF) ----
# Started by modelrig-supervisor, one process per GPU, only when KALIV_MEDIA_EXECUTOR=1. Leave this whole
# block commented out until the rig qualification pack (#2296) has passed and activation is approved.
# Images only for now. Paths must be absolute; nothing is created, and media never touches the internal disk.
# KALIV_MEDIA_EXECUTOR=1                     # master switch; anything else is off
# KALIV_MEDIA_EXECUTOR_DEVICES=cuda:0        # one executor per entry, e.g. cuda:0,cuda:1
# KALIV_MEDIA_EXECUTOR_PYTHON=C:\kaliv-media\genvenv\Scripts\python.exe   # media environment (torch, diffusers)
# KALIV_MEDIA_EXECUTOR_APP_DIR=C:\ModelRig\worker                        # folder that contains app\media_executor_main.py
# KALIV_MEDIA_JOB_DB=C:\ModelRig\media-jobs.sqlite3                      # job database (prompts blanked 30 days after a job ends)
# KALIV_MEDIA_VOLUME_ROOT=E:\                # the external media volume (a mount point)
# KALIV_MEDIA_ROOT=E:\kaliv-media\gallery    # gallery folder on that volume
# KALIV_MEDIA_PROFILE_DIR=C:\ModelRig\media-profiles
# KALIV_MEDIA_PROFILES_ENABLED=sdxl          # comma-separated profile ids; nothing runs unless listed
# KALIV_GPU_LEASE_DIR=C:\ModelRig\gpu-lease  # absolute, owned by the service account, not writable by others (DACL checked; under C:\ remove inheritance, see docs/MEDIA_GENERATION_PROFILES.md)
# KALIV_GPU_DEVICE_UUIDS=cuda:0=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # from: nvidia-smi --query-gpu=index,uuid --format=csv
# CUDA_DEVICE_ORDER=PCI_BUS_ID               # required so cuda:N means the same GPU everywhere
# HF_HUB_OFFLINE=1                           # required: never a download at run time
# TRANSFORMERS_OFFLINE=1                     # required
# KALIV_MEDIA_IDLE_UNLOAD_S=300              # unload an idle model so the GPU is free for Ollama
