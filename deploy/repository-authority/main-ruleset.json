{
  "_comment": "ADR-SYS-003 D1/D5: the single active branch ruleset for main. Applied by scripts/configure-repository-authority-ruleset.ps1, never edited in the UI. Verified offline by scripts/repository_authority.py (tests/workflow_repository_authority.py). Field names follow the GitHub REST rulesets API.",
  "name": "ModelRig main — merge queue (ADR-SYS-003)",
  "target": "branch",
  "enforcement": "active",
