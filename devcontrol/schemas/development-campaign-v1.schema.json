{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-campaign-v1.json",
  "title": "Kaliv development campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "task_id", "task_sha256", "base_sha", "events"],
  "properties": {
    "schema": {"const": "kaliv-development-campaign/v1"},
    "campaign_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "sequence",
          "state",
          "evidence_sha256",
          "detail",
          "previous_event_sha256",
          "event_sha256"
        ],
        "properties": {
          "schema": {"const": "kaliv-development-campaign-event/v1"},
          "sequence": {"type": "integer", "minimum": 0},
          "state": {
            "enum": [
              "created",
              "workspace_ready",
              "patch_staged",
              "tested",
              "reviewed",
              "ready_for_draft_pr",
              "failed",
              "cancelled"
            ]
          },
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "detail": {"type": "string", "minLength": 1, "maxLength": 2048},
          "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
