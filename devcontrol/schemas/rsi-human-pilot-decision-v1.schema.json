{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-human-pilot-decision-v1.schema.json",
  "title": "ModelRig RSI human pilot decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "decision_id", "completion_proof_sha256", "campaign_id", "task_id",
    "task_sha256", "repository", "base_sha", "requested_main_sha",
    "decision_maker_actor_id", "decision", "operator_surface", "allowed_task_ids",
    "workspace_root_path_sha256", "local_commits_allowed", "notes", "decided_at_utc",
    "feature_flag_default_off", "local_only_scope_confirmed", "kill_switch_required",
    "restart_revoke_required", "unattended_cadence_allowed", "remote_write_allowed",
    "push_allowed", "pr_mutation_allowed", "merge_allowed", "release_allowed",
    "deploy_allowed", "production_activation_allowed", "authority"
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema": {"const": "kaliv-rsi-human-pilot-decision/v1"},
    "decision_id": {"$ref": "#/$defs/identifier"},
    "completion_proof_sha256": {"$ref": "#/$defs/sha64"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"$ref": "#/$defs/sha64"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "requested_main_sha": {"$ref": "#/$defs/sha40"},
    "decision_maker_actor_id": {"$ref": "#/$defs/actor"},
    "decision": {"enum": ["go", "no_go", "go_with_conditions"]},
    "operator_surface": {"$ref": "#/$defs/identifier"},
    "allowed_task_ids": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "workspace_root_path_sha256": {"$ref": "#/$defs/sha64"},
    "local_commits_allowed": {"type": "boolean"},
    "notes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "decided_at_utc": {"$ref": "#/$defs/utc"},
    "feature_flag_default_off": {"const": true},
    "local_only_scope_confirmed": {"const": true},
    "kill_switch_required": {"const": true},
    "restart_revoke_required": {"const": true},
    "unattended_cadence_allowed": {"const": false},
    "remote_write_allowed": {"const": false},
    "push_allowed": {"const": false},
    "pr_mutation_allowed": {"const": false},
    "merge_allowed": {"const": false},
    "release_allowed": {"const": false},
    "deploy_allowed": {"const": false},
    "production_activation_allowed": {"const": false},
    "authority": {"const": "human-dc-l16-pilot-decision-claim-only"}
  }
}
