    "local_commit_created": {"const": true},
    "local_head_ref_verified": {"const": true},
    "commit_object_verified": {"const": true},
    "commit_payload_verified": {"const": true},
    "parent_base_verified": {"const": true},
    "root_tree_verified": {"const": true},
    "index_manifest_preserved": {"const": true},
