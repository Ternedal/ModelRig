{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-exact-task-product-pilot-execution-admission-v1.schema.json",
  "title": "ModelRig product-pilot execution admission receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "start_state_source_type": {
      "type": "string",
      "enum": [
        "start_transaction",
        "completed_recovery"
      ]
    },
    "start_state_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "start_transaction_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_readiness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_requirements_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_lineage_attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_task_registry_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_runtime_preflight_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fresh_human_decision_proof_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_development_task_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_task_id": {
      "type": "string",
      "minLength": 1
    },
    "development_task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_task_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixed_command_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "Ternedal/ModelRig"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "merge_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "product_pilot_id": {
      "const": "modelrig-product-pilot-v1"
    },
    "operator_surface": {
      "type": "string",
      "minLength": 1
    },
    "selected_pilot_task_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feature_flag_name": {
      "type": "string",
      "minLength": 1
    },
    "product_route": {
      "type": "string",
      "pattern": "^/"
    },
    "source_completed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "admitted_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "start_state_authenticated": {
      "const": true
    },
    "host_development_task_registry_reverified": {
      "const": true
    },
    "exact_development_task_reverified": {
      "const": true
    },
    "single_fixed_command_reverified": {
      "const": true
    },
    "exact_workspace_scope_bound": {
      "const": true
    },
    "fresh_runtime_revalidation_required": {
      "const": true
    },
    "fresh_workspace_snapshot_required": {
      "const": true
    },
    "executor_capability_materialization_authorized": {
      "const": true
    },
    "next_boundary_executor_capability_required": {
      "const": true
    },
    "execution_plan_materialization_authorized": {
      "const": false
    },
    "task_execution_authorized": {
      "const": false
    },
    "local_commit_authorized": {
      "const": false
    },
    "remote_write_authorized": {
      "const": false
    },
    "push_authorized": {
      "const": false
    },
    "pr_mutation_authorized": {
      "const": false
    },
    "merge_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "deploy_authorized": {
      "const": false
    },
    "production_activation_authorized": {
      "const": false
    },
    "nonce_reusable": {
      "const": false
    },
    "admission_scope": {
      "const": "completed-start-to-existing-tier-a-executor-bridge-only-v1"
    },
    "authority": {
      "const": "host-revalidated-product-pilot-executor-bridge-admission-only"
    },
    "schema": {
      "const": "kaliv-rsi-dc-l16-exact-task-product-pilot-execution-admission-receipt/v1"
    }
  },
  "required": [
    "start_state_source_type",
    "start_state_source_sha256",
    "start_transaction_receipt_sha256",
    "product_pilot_start_authorization_sha256",
    "product_pilot_start_readiness_sha256",
    "product_pilot_start_requirements_sha256",
    "product_pilot_lineage_attestation_sha256",
    "product_pilot_task_registry_receipt_sha256",
    "product_pilot_runtime_preflight_receipt_sha256",
    "fresh_human_decision_proof_sha256",
    "host_development_task_registry_sha256",
    "development_task_id",
    "development_task_sha256",
    "development_task_base_sha",
    "fixed_command_id",
    "repository",
    "repository_id",
    "merge_commit_sha",
    "product_pilot_id",
    "operator_surface",
    "selected_pilot_task_id",
    "workspace_root_path_sha256",
    "feature_flag_name",
    "product_route",
    "source_completed_at_utc",
    "admitted_at_utc",
    "source_age_seconds",
    "start_state_authenticated",
    "host_development_task_registry_reverified",
    "exact_development_task_reverified",
    "single_fixed_command_reverified",
    "exact_workspace_scope_bound",
    "fresh_runtime_revalidation_required",
    "fresh_workspace_snapshot_required",
    "executor_capability_materialization_authorized",
    "next_boundary_executor_capability_required",
    "execution_plan_materialization_authorized",
    "task_execution_authorized",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "nonce_reusable",
    "admission_scope",
    "authority",
    "schema"
  ]
}
