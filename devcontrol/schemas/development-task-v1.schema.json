{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-task-v1.json",
  "title": "Kaliv Development Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "repository",
    "base_sha",
    "goal",
    "acceptance_criteria",
    "risk",
    "allowed_paths",
    "protected_paths",
    "allowed_command_ids",
    "required_tests",
    "budget",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-task/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4096},
    "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk": {"enum": ["trivial", "low", "medium", "high"]},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_command_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}},
    "required_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "merge_authority": {"const": "human"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_changed_files", "max_added_lines", "max_deleted_lines", "max_attempts", "max_runtime_seconds", "max_output_bytes"],
      "properties": {
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 200},
        "max_added_lines": {"type": "integer", "minimum": 1, "maximum": 50000},
        "max_deleted_lines": {"type": "integer", "minimum": 0, "maximum": 50000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_runtime_seconds": {"type": "integer", "minimum": 10, "maximum": 86400},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 100000000}
      }
    }
  }
}
