{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaliv-rsi-dc-l16-product-integration-selection-candidate-proof/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "trial_scope_sha256", "decision_proof_sha256", "repository", "base_sha",
    "requested_main_sha", "trial_id", "operator_surface", "selected_pilot_task_id",
    "workspace_root_path_sha256", "local_commits_allowed", "inventory_source_head_sha",
    "inventory_git_blob_sha", "selection_requirements_git_blob_sha", "candidate_id",
    "candidate_kind", "candidate_path", "candidate_git_blob_sha", "feature_flag_name",
    "product_route", "runtime_observer_id", "task_registry_id", "workspace_policy_id",
    "review_authorization_roles_id", "kill_revoke_cleanup_id", "local_commit_policy",
    "human_pilot_go_verified", "pilot_scope_verified", "source_inventory_verified",
    "selection_requirements_verified", "design_candidate_validated", "human_selection_recorded",
    "integration_ready", "preflight_observed", "preflight_satisfied", "pilot_start_authorized",
    "product_pilot_started", "remote_write_authorized", "push_authorized",
    "pr_mutation_authorized", "merge_authorized", "release_authorized", "deploy_authorized",
    "production_activation_authorized", "authority"
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"}
  },
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-product-integration-selection-candidate-proof/v1"},
    "trial_scope_sha256": {"$ref": "#/$defs/sha64"},
    "decision_proof_sha256": {"$ref": "#/$defs/sha64"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "requested_main_sha": {"$ref": "#/$defs/sha40"},
    "trial_id": {"$ref": "#/$defs/id"},
    "operator_surface": {"enum": ["desktop.control-center", "android.control-center", "backend.local-api-host-pattern"]},
    "selected_pilot_task_id": {"$ref": "#/$defs/id"},
    "workspace_root_path_sha256": {"$ref": "#/$defs/sha64"},
    "local_commits_allowed": {"type": "boolean"},
    "inventory_source_head_sha": {"const": "30be16b320acd6655c07ab1476cceaead547e3e3"},
    "inventory_git_blob_sha": {"const": "babad0dfc82ad359ee053817bae2674a8f8b38a0"},
    "selection_requirements_git_blob_sha": {"const": "36253b5a0ee8807f51eaeb8c0cf10276e0bc7a63"},
    "candidate_id": {"enum": ["desktop.control-center", "android.control-center", "backend.local-api-host-pattern"]},
    "candidate_kind": {"enum": ["operator-ui-candidate", "route-host-pattern-candidate"]},
    "candidate_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "candidate_git_blob_sha": {"$ref": "#/$defs/sha40"},
    "feature_flag_name": {"type": "string", "pattern": "^KALIV_[A-Z0-9_]{3,96}$"},
    "product_route": {"type": "string", "pattern": "^/api/v1/[a-z0-9][a-z0-9/_-]{1,127}$"},
    "runtime_observer_id": {"$ref": "#/$defs/id"},
    "task_registry_id": {"$ref": "#/$defs/id"},
    "workspace_policy_id": {"$ref": "#/$defs/id"},
    "review_authorization_roles_id": {"$ref": "#/$defs/id"},
    "kill_revoke_cleanup_id": {"$ref": "#/$defs/id"},
    "local_commit_policy": {"enum": ["forbid", "allow-local-only"]},
    "human_pilot_go_verified": {"const": true},
    "pilot_scope_verified": {"const": true},
    "source_inventory_verified": {"const": true},
    "selection_requirements_verified": {"const": true},
    "design_candidate_validated": {"const": true},
    "human_selection_recorded": {"const": false},
    "integration_ready": {"const": false},
    "preflight_observed": {"const": false},
    "preflight_satisfied": {"const": false},
    "pilot_start_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "dc-l16-product-integration-selection-candidate-only"}
  }
}
