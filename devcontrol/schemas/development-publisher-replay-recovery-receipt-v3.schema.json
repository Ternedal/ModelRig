{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://modelrig.invalid/schemas/development-publisher-replay-recovery-receipt-v3.schema.json","title":"Publisher replay recovery receipt v3","type":"object","additionalProperties":false,"required":["schema","authorization","authorization_sha256","core_receipt","core_receipt_sha256","lease_sha256","invocation_nonce","ledger_id","recovered_at_utc","action","state_before","state_after","entry_verified","authorization_embedded","nonce_reusable"],"properties":{"schema":{"const":"kaliv-development-publisher-replay-recovery-receipt/v3"},"authorization":{"$ref":"development-publisher-replay-recovery-authorization-v1.schema.json"},"authorization_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"core_receipt":{"$ref":"development-publisher-replay-recovery-receipt-v2.schema.json"},"core_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"lease_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"invocation_nonce":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ledger_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},"recovered_at_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"action":{"enum":["finalize_prepared","acknowledge_committed","tombstone_uncertain"]},"state_before":{"enum":["reserved","partial","prepared","committed","committed_locked"]},"state_after":{"enum":["committed","tombstoned"]},"entry_verified":{"type":"boolean"},"authorization_embedded":{"const":true},"nonce_reusable":{"const":false}}}
