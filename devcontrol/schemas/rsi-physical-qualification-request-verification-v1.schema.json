{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-qualification-request-verification-v1.schema.json",
  "title": "ModelRig RSI physical qualification request verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_sha256",
    "qualification_packet_sha256",
    "signature_sha256",
    "requester_actor_id",
    "requested_frozen_main_sha",
    "collector_actor_id",
    "approver_actor_id",
    "required_probes",
    "verified_at_utc",
    "human_request_verified",
    "exact_frozen_main_confirmed",
    "physical_campaign_completed",
    "request_consumed",
    "replay_guard_required",
    "campaign_start_authorized",
    "pilot_go_authorized",
    "activation_authorized",
    "remote_publication_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-qualification-request-verification/v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requester_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "requested_frozen_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "collector_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "required_probes": {
      "const": [
        "restricted_token",
        "workspace_allowed",
        "workspace_escape_denied",
        "network_denied",
        "process_tree_timeout_cleanup",
        "process_tree_crash_cleanup",
        "cancel_cleanup",
        "reboot_cleanup",
        "memory_limit_enforced",
        "process_limit_enforced",
        "existing_tools_compatible"
      ]
    },
    "verified_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "human_request_verified": {"const": true},
    "exact_frozen_main_confirmed": {"const": false},
    "physical_campaign_completed": {"const": false},
    "request_consumed": {"const": false},
    "replay_guard_required": {"const": true},
    "campaign_start_authorized": {"const": false},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "authority": {"const": "verified-request-evidence-only"}
  }
}
