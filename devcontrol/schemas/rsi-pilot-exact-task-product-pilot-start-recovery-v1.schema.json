{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-exact-task-product-pilot-start-recovery-v1.schema.json",
  "title": "ModelRig RSI product-pilot start recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recovery_ledger_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_ledger_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_ledger_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "product_pilot_start_readiness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "const": "Ternedal/ModelRig"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "merge_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "product_pilot_id": {
      "const": "modelrig-product-pilot-v1"
    },
    "recovery_state_class": {
      "type": "string",
      "enum": [
        "completed_verified",
        "reserved_not_started"
      ]
    },
    "recovered_start_transaction_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "second_observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "recovered_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "transaction_lock_verified": {
      "const": true
    },
    "durable_start_authorization_verified": {
      "const": true
    },
    "double_observation_matched": {
      "const": true
    },
    "recovery_classification_verified": {
      "const": true
    },
    "start_receipt_verified": {
      "type": "boolean"
    },
    "product_pilot_start_authorized": {
      "const": false
    },
    "product_pilot_started": {
      "type": "boolean"
    },
    "reserved_start_not_started": {
      "type": "boolean"
    },
    "manual_intervention_required": {
      "type": "boolean"
    },
    "task_execution_authorized": {
      "const": false
    },
    "local_commit_authorized": {
      "const": false
    },
    "remote_write_authorized": {
      "const": false
    },
    "push_authorized": {
      "const": false
    },
    "pr_mutation_authorized": {
      "const": false
    },
    "merge_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "deploy_authorized": {
      "const": false
    },
    "production_activation_authorized": {
      "const": false
    },
    "nonce_reusable": {
      "const": false
    },
    "next_boundary_execution_authorization_required": {
      "type": "boolean"
    },
    "recovery_scope": {
      "const": "write-free-product-pilot-start-ledger-recovery-classification-v1"
    },
    "ledger_scope": {
      "const": "canonical-host-local-v1"
    },
    "authority": {
      "const": "host-classified-dc-l16-product-pilot-start-recovery-only"
    },
    "schema": {
      "const": "kaliv-rsi-dc-l16-exact-task-product-pilot-start-recovery-receipt/v1"
    }
  },
  "required": [
    "recovery_ledger_root_path_sha256",
    "recovery_key_sha256",
    "recovery_observation_sha256",
    "transaction_key_sha256",
    "transaction_lock_sha256",
    "transaction_ledger_root_path_sha256",
    "product_pilot_start_authorization_sha256",
    "authorization_ledger_root_path_sha256",
    "product_pilot_start_intent_sha256",
    "product_pilot_start_readiness_sha256",
    "repository",
    "repository_id",
    "merge_commit_sha",
    "product_pilot_id",
    "recovery_state_class",
    "recovered_start_transaction_receipt_sha256",
    "first_observed_at_utc",
    "second_observed_at_utc",
    "recovered_at_utc",
    "transaction_lock_verified",
    "durable_start_authorization_verified",
    "double_observation_matched",
    "recovery_classification_verified",
    "start_receipt_verified",
    "product_pilot_start_authorized",
    "product_pilot_started",
    "reserved_start_not_started",
    "manual_intervention_required",
    "task_execution_authorized",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "nonce_reusable",
    "next_boundary_execution_authorization_required",
    "recovery_scope",
    "ledger_scope",
    "authority",
    "schema"
  ]
}
