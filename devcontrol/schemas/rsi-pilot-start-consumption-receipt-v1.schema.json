{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaliv-rsi-dc-l16-pilot-start-consumption-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_scope",
    "ledger_root_path_sha256",
    "authorization_proof",
    "authorization_proof_sha256",
    "fresh_authorization_proof_sha256",
    "authorization_sha256",
    "authorization_signature_sha256",
    "preflight_signature_sha256",
    "start_nonce_sha256",
    "fresh_verified_at_utc",
    "consumed_at_utc",
    "host_replay_guard_committed",
    "global_replay_safe",
    "one_shot_start_required",
    "start_consumed",
    "start_receipt_issued",
    "pilot_start_authorized",
    "task_execution_authorized",
    "integration_ready",
    "product_pilot_started",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-pilot-start-consumption-receipt/v1"},
    "ledger_scope": {"const": "canonical-host-local-v1"},
    "ledger_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_proof": {"type": "object"},
    "authorization_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fresh_authorization_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "start_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fresh_verified_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "consumed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "host_replay_guard_committed": {"const": true},
    "global_replay_safe": {"const": false},
    "one_shot_start_required": {"const": true},
    "start_consumed": {"const": true},
    "start_receipt_issued": {"const": true},
    "pilot_start_authorized": {"const": true},
    "task_execution_authorized": {"const": false},
    "integration_ready": {"const": false},
    "product_pilot_started": {"const": false},
    "local_commit_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "host-consumed-dc-l16-pilot-start-authorization-only"}
  }
}
