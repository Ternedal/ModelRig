{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-independent-human-verdict-v1.schema.json",
  "title": "ModelRig RSI independent human physical-campaign verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "verdict_id", "main_freeze_proof_sha256", "execution_proof_sha256",
    "evidence_snapshot_sha256", "admission_sha256", "campaign_id", "task_id",
    "task_sha256", "repository", "base_sha", "requested_main_sha", "operator_actor_id",
    "approver_actor_id", "reviewer_actor_id", "decision", "findings", "reviewed_at_utc",
    "physical_evidence_reviewed", "runner_execution_binding_reviewed",
    "continuous_main_freeze_reviewed", "independent_reviewer_confirmed", "authority"
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-independent-human-verdict/v1"},
    "verdict_id": {"$ref": "#/$defs/identifier"},
    "main_freeze_proof_sha256": {"$ref": "#/$defs/sha64"},
    "execution_proof_sha256": {"$ref": "#/$defs/sha64"},
    "evidence_snapshot_sha256": {"$ref": "#/$defs/sha64"},
    "admission_sha256": {"$ref": "#/$defs/sha64"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"$ref": "#/$defs/sha64"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "requested_main_sha": {"$ref": "#/$defs/sha40"},
    "operator_actor_id": {"$ref": "#/$defs/actor"},
    "approver_actor_id": {"$ref": "#/$defs/actor"},
    "reviewer_actor_id": {"$ref": "#/$defs/actor"},
    "decision": {"enum": ["approve", "request_changes", "reject"]},
    "findings": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "reviewed_at_utc": {"$ref": "#/$defs/utc"},
    "physical_evidence_reviewed": {"const": true},
    "runner_execution_binding_reviewed": {"const": true},
    "continuous_main_freeze_reviewed": {"const": true},
    "independent_reviewer_confirmed": {"const": true},
    "authority": {"const": "human-independent-dc-l15-verdict-only"}
  }
}
