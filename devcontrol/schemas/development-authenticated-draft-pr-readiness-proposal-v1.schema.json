{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/development-authenticated-draft-pr-readiness-proposal-v1.schema.json",
  "title": "Authenticated draft pull-request readiness proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task",
    "task_sha256",
    "repository",
    "base_branch",
    "base_sha",
    "head_branch",
    "title",
    "body",
    "staged_patch_sha256",
    "staged_patch_bytes",
    "receipt_sha256",
    "semantic_review_request",
    "semantic_review_request_sha256",
    "signed_semantic_review_verdict",
    "signed_semantic_review_verdict_sha256",
    "reviewer_actor_id",
    "reviewer_key_id",
    "execution_authority_sha256",
    "review_policy_sha256",
    "proposal_policy_sha256",
    "draft",
    "merge_authority"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-development-authenticated-draft-pr-readiness-proposal/v1"
    },
    "task": {
      "type": "object"
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "maxLength": 200
    },
    "base_branch": {
      "$ref": "#/$defs/branch"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_branch": {
      "$ref": "#/$defs/branch"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "staged_patch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "staged_patch_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "semantic_review_request": {
      "type": "object"
    },
    "semantic_review_request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "signed_semantic_review_verdict": {
      "type": "object"
    },
    "signed_semantic_review_verdict_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer_actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"
    },
    "reviewer_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "execution_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "draft": {
      "const": true
    },
    "merge_authority": {
      "const": "human"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![./])(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+$"
    }
  }
}
