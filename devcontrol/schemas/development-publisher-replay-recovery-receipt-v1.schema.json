{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-publisher-replay-recovery-receipt-v1.json",
  "title": "Kaliv development publisher replay recovery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lease_sha256",
    "invocation_nonce",
    "ledger_id",
    "recovery_authorization_sha256",
    "operator_actor_id",
    "recovered_at_utc",
    "action",
    "state_before",
    "state_after",
    "entry_verified",
    "nonce_reusable"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-publisher-replay-recovery-receipt/v1"},
    "lease_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invocation_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"},
    "recovery_authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{1,127}$"},
    "recovered_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "action": {"enum": ["finalize_prepared", "acknowledge_committed", "tombstone_uncertain"]},
    "state_before": {"enum": ["absent", "reserved", "partial", "prepared", "committed", "committed_locked", "tombstoned", "conflict"]},
    "state_after": {"enum": ["absent", "reserved", "partial", "prepared", "committed", "committed_locked", "tombstoned", "conflict"]},
    "entry_verified": {"type": "boolean"},
    "nonce_reusable": {"const": false}
  }
}
