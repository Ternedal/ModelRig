{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaliv-rsi-dc-l16-runtime-preflight-binding-plan/v1",
  "title": "DC-L16 runtime preflight binding plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requirements_sha256",
    "human_selection_proof_sha256",
    "requirements",
    "human_selection_proof",
    "repository",
    "base_sha",
    "requested_main_sha",
    "trial_id",
    "operator_surface",
    "selected_pilot_task_id",
    "workspace_root_path_sha256",
    "local_commits_allowed",
    "feature_flag_name",
    "product_route",
    "runtime_observer_id",
    "task_registry_id",
    "workspace_policy_id",
    "review_authorization_roles_id",
    "kill_revoke_cleanup_id",
    "local_commit_policy",
    "preflight_requirements_verified",
    "human_selection_recorded",
    "candidate_selection_verified",
    "preflight_binding_verified",
    "integration_ready",
    "preflight_observed",
    "preflight_satisfied",
    "pilot_start_authorized",
    "product_pilot_started",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-runtime-preflight-binding-plan/v1"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "human_selection_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {"$ref": "rsi-pilot-preflight-requirements-v1.schema.json"},
    "human_selection_proof": {"$ref": "rsi-pilot-product-integration-human-selection-proof-v1.schema.json"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "operator_surface": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "selected_pilot_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "workspace_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_commits_allowed": {"type": "boolean"},
    "feature_flag_name": {"type": "string", "pattern": "^KALIV_[A-Z0-9_]{3,96}$"},
    "product_route": {"type": "string", "pattern": "^/api/v1/[a-z0-9][a-z0-9/_-]{1,127}$"},
    "runtime_observer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "task_registry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "workspace_policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "review_authorization_roles_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "kill_revoke_cleanup_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "local_commit_policy": {"enum": ["forbid", "allow-local-only"]},
    "preflight_requirements_verified": {"const": true},
    "human_selection_recorded": {"const": true},
    "candidate_selection_verified": {"const": true},
    "preflight_binding_verified": {"const": true},
    "integration_ready": {"const": false},
    "preflight_observed": {"const": false},
    "preflight_satisfied": {"const": false},
    "pilot_start_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "dc-l16-runtime-preflight-binding-plan-only"}
  }
}
