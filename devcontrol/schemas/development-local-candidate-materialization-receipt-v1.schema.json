{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/development-local-candidate-materialization-receipt-v1.schema.json",
  "title": "Local candidate materialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preflight",
    "preflight_sha256",
    "lease_sha256",
    "replay_entry_sha256",
    "request_sha256",
    "readiness_sha256",
    "task_sha256",
    "invocation_nonce",
    "materialization_policy_sha256",
    "materialized_at_utc",
    "transaction_id",
    "repository_relative_path",
    "receipt_relative_path",
    "git",
    "source",
    "candidate",
    "bare_repository",
    "isolated_index",
    "local_source_only",
    "remote_configured",
    "network_write_performed",
    "remote_push_performed",
    "pull_request_created",
    "ready_for_review",
    "reviewers_requested",
    "merged",
    "released",
    "deployed",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-local-candidate-materialization-receipt/v1"},
    "preflight": {"type": "object"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "lease_sha256": {"$ref": "#/$defs/sha256"},
    "replay_entry_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_sha256": {"$ref": "#/$defs/sha256"},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "invocation_nonce": {"$ref": "#/$defs/sha256"},
    "materialization_policy_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_at_utc": {"$ref": "#/$defs/utc"},
    "transaction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "repository_relative_path": {"const": "repository.git"},
    "receipt_relative_path": {"const": "receipt.json"},
    "git": {"$ref": "#/$defs/git"},
    "source": {"$ref": "#/$defs/source"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "bare_repository": {"const": true},
    "isolated_index": {"const": true},
    "local_source_only": {"const": true},
    "remote_configured": {"const": false},
    "network_write_performed": {"const": false},
    "remote_push_performed": {"const": false},
    "pull_request_created": {"const": false},
    "ready_for_review": {"const": false},
    "reviewers_requested": {"const": false},
    "merged": {"const": false},
    "released": {"const": false},
    "deployed": {"const": false},
    "merge_authority": {"const": "human"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "executable_sha256",
        "executable_bytes",
        "executable_basename",
        "version",
        "object_format"
      ],
      "properties": {
        "schema": {"const": "kaliv-development-local-git-evidence/v1"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "executable_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "executable_basename": {"type": "string", "minLength": 1, "maxLength": 255},
        "version": {"type": "string", "minLength": 1, "maxLength": 512},
        "object_format": {"const": "sha1"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path_sha256",
        "repository_kind",
        "state_sha256",
        "state_bytes",
        "base_commit_sha",
        "base_commit_object_sha256",
        "base_commit_object_bytes",
        "base_tree_sha",
        "base_tree_object_sha256",
        "base_tree_object_bytes",
        "source_mutated",
        "object_format",
        "shallow"
      ],
      "properties": {
        "schema": {"const": "kaliv-development-local-source-repository-evidence/v1"},
        "path_sha256": {"$ref": "#/$defs/sha256"},
        "repository_kind": {"enum": ["bare", "worktree"]},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "state_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "base_commit_sha": {"$ref": "#/$defs/sha1"},
        "base_commit_object_sha256": {"$ref": "#/$defs/sha256"},
        "base_commit_object_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "base_tree_sha": {"$ref": "#/$defs/sha1"},
        "base_tree_object_sha256": {"$ref": "#/$defs/sha256"},
        "base_tree_object_bytes": {"type": "integer", "minimum": 0, "maximum": 33554432},
        "source_mutated": {"const": false},
        "object_format": {"const": "sha1"},
        "shallow": {"const": false}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "parent_sha",
        "staged_patch_sha256",
        "staged_patch_bytes",
        "tree_sha",
        "tree_object_sha256",
        "tree_object_bytes",
        "commit_sha",
        "commit_object_sha256",
        "commit_object_bytes",
        "commit_message",
        "commit_message_sha256",
        "author_actor_id",
        "author_name",
        "author_email",
        "author_git_timestamp",
        "committer_actor_id",
        "committer_name",
        "committer_email",
        "committer_git_timestamp",
        "head_branch",
        "branch_ref",
        "branch_target_sha",
        "head_symbolic_ref",
        "exact_patch_reproduced"
      ],
      "properties": {
        "schema": {"const": "kaliv-development-local-candidate-commit-evidence/v1"},
        "parent_sha": {"$ref": "#/$defs/sha1"},
        "staged_patch_sha256": {"$ref": "#/$defs/sha256"},
        "staged_patch_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "tree_sha": {"$ref": "#/$defs/sha1"},
        "tree_object_sha256": {"$ref": "#/$defs/sha256"},
        "tree_object_bytes": {"type": "integer", "minimum": 0, "maximum": 33554432},
        "commit_sha": {"$ref": "#/$defs/sha1"},
        "commit_object_sha256": {"$ref": "#/$defs/sha256"},
        "commit_object_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "commit_message": {"type": "string", "minLength": 1, "maxLength": 240},
        "commit_message_sha256": {"$ref": "#/$defs/sha256"},
        "author_actor_id": {"$ref": "#/$defs/actor"},
        "author_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "author_email": {"type": "string", "minLength": 1, "maxLength": 200},
        "author_git_timestamp": {"type": "string", "pattern": "^[0-9]+ \\+0000$"},
        "committer_actor_id": {"$ref": "#/$defs/actor"},
        "committer_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "committer_email": {"type": "string", "minLength": 1, "maxLength": 200},
        "committer_git_timestamp": {"type": "string", "pattern": "^[0-9]+ \\+0000$"},
        "head_branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "branch_ref": {"type": "string", "minLength": 1, "maxLength": 260},
        "branch_target_sha": {"$ref": "#/$defs/sha1"},
        "head_symbolic_ref": {"type": "string", "minLength": 1, "maxLength": 260},
        "exact_patch_reproduced": {"const": true}
      }
    }
  }
}
