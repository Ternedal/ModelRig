{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-review-verdict-v1.json",
  "title": "Kaliv development review verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_request_sha256",
    "developer_actor_id",
    "reviewer_actor_id",
    "independent",
    "decision",
    "findings"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-review-verdict/v1"},
    "review_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "developer_actor_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$"},
    "reviewer_actor_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$"},
    "independent": {"const": true},
    "decision": {"enum": ["approve", "request_changes", "reject"]},
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    }
  }
}
