{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-exact-task-pr-lifecycle-authorization-v1.schema.json",
  "title": "RSI pilot exact-task PR lifecycle authorization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle_ledger_root_path_sha256",
    "lifecycle_key_sha256",
    "lifecycle_authorization_payload_sha256",
    "post_publication_attestation_sha256",
    "lifecycle_config_sha256",
    "reviewer_set_sha256",
    "execution_nonce_sha256",
    "development_task_sha256",
    "candidate_patch_sha256",
    "pr_intent_sha256",
    "repository",
    "repository_id",
    "base_branch",
    "head_branch",
    "predicted_commit_sha",
    "pull_request_number",
    "pull_request_api_url",
    "reviewer_usernames",
    "reviewer_team_slugs",
    "authorizer_actor_id",
    "authorizer_system_id",
    "authorizer_key_id",
    "requested_at_utc",
    "expires_at_utc",
    "reserved_at_utc",
    "host_lifecycle_guard_committed",
    "post_publication_attestation_authenticated",
    "post_publication_verified",
    "lifecycle_config_host_pinned",
    "external_ed25519_authorized",
    "ready_for_review_authorized",
    "reviewer_request_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "product_pilot_started",
    "authorization_scope",
    "authority",
    "schema"
  ],
  "properties": {
    "lifecycle_ledger_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_authorization_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_publication_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "development_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pr_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "minLength": 3, "maxLength": 200},
    "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "base_branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "head_branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "predicted_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "pull_request_api_url": {"type": "string", "minLength": 1, "maxLength": 500},
    "reviewer_usernames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 20},
    "reviewer_team_slugs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 20},
    "authorizer_actor_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "authorizer_system_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "authorizer_key_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "requested_at_utc": {"type": "string"},
    "expires_at_utc": {"type": "string"},
    "reserved_at_utc": {"type": "string"},
    "host_lifecycle_guard_committed": {"const": true},
    "post_publication_attestation_authenticated": {"const": true},
    "post_publication_verified": {"const": true},
    "lifecycle_config_host_pinned": {"const": true},
    "external_ed25519_authorized": {"const": true},
    "ready_for_review_authorized": {"const": true},
    "reviewer_request_authorized": {"const": true},
    "remote_write_authorized": {"const": true},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": true},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "authorization_scope": {"const": "ready-for-review-and-exact-reviewer-request-only-v1"},
    "authority": {"const": "externally-authorized-one-dc-l16-exact-pr-lifecycle-only"},
    "schema": {"const": "kaliv-rsi-dc-l16-exact-task-pr-lifecycle-authorization-receipt/v1"}
  }
}
