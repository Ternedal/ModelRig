    "one_shot_local_write_nonce_required": {"type": "boolean", "const": true},
    "local_write_nonce_distinct_from_execution_nonce_required": {"type": "boolean", "const": true},
    "canonical_local_write_ledger_required": {"type": "boolean", "const": true},
    "durable_prewrite_reservation_required": {"type": "boolean", "const": true},
    "reservation_before_git_object_write_required": {"type": "boolean", "const": true},
