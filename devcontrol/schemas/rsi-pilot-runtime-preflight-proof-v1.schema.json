{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaliv-rsi-dc-l16-pilot-runtime-preflight-proof/v1",
  "title": "DC-L16 verified runtime preflight proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_sha256",
    "signature_sha256",
    "key_id",
    "issuer_actor_id",
    "issuer_system_id",
    "selection_proof",
    "requirements",
    "observation",
    "verified_at_utc",
    "selection_proof_sha256",
    "requirements_sha256",
    "candidate_proof_sha256",
    "preflight_observed",
    "preflight_satisfied",
    "integration_ready",
    "pilot_start_authorized",
    "product_pilot_started",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-pilot-runtime-preflight-proof/v1"},
    "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "minLength": 1},
    "issuer_actor_id": {"type": "string", "minLength": 1},
    "issuer_system_id": {"const": "kaliv-rsi-dc-l16-pilot-runtime-preflight-observer-v1"},
    "selection_proof": {"type": "object"},
    "requirements": {"type": "object"},
    "observation": {"type": "object"},
    "verified_at_utc": {"type": "string", "minLength": 1},
    "selection_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_observed": {"const": true},
    "preflight_satisfied": {"type": "boolean"},
    "integration_ready": {"const": false},
    "pilot_start_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "verified-dc-l16-pilot-runtime-preflight-only"}
  }
}
