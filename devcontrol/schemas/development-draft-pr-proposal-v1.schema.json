{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-draft-pr-proposal-v1.json",
  "title": "Kaliv development draft PR proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "base_branch",
    "base_sha",
    "head_branch",
    "title",
    "body",
    "task_sha256",
    "campaign_head_sha256",
    "review_request_sha256",
    "review_verdict_sha256",
    "draft",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-draft-pr-proposal/v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_branch": {"type": "string", "pattern": "^kaliv-dev/[A-Za-z0-9._/-]{1,180}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "body": {"type": "string", "minLength": 1, "maxLength": 50000},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_head_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "draft": {"const": true},
    "merge_authority": {"const": "human"}
  }
}
