{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/devcontrol/rsi-pilot-exact-task-development-task-registry-v1.schema.json",
  "title": "ModelRig RSI DC-L16 exact pilot task to DevelopmentTask registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-exact-task-development-task-registry/v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selected_pilot_task_id", "development_task", "development_task_sha256"],
        "properties": {
          "selected_pilot_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "development_task": {"$ref": "#/$defs/developmentTask"},
          "development_task_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_changed_files", "max_added_lines", "max_deleted_lines", "max_attempts", "max_runtime_seconds", "max_output_bytes"],
      "properties": {
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 200},
        "max_added_lines": {"type": "integer", "minimum": 1, "maximum": 50000},
        "max_deleted_lines": {"type": "integer", "minimum": 0, "maximum": 50000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_runtime_seconds": {"type": "integer", "minimum": 10, "maximum": 86400},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 100000000}
      }
    },
    "developmentTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "repository", "base_sha", "goal", "acceptance_criteria", "risk", "allowed_paths", "protected_paths", "allowed_command_ids", "required_tests", "budget", "merge_authority"],
      "properties": {
        "schema": {"const": "kaliv-development-task/v1"},
        "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
        "repository": {"const": "Ternedal/ModelRig"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "goal": {"type": "string", "minLength": 1, "maxLength": 4096},
        "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "risk": {"enum": ["trivial", "low", "medium", "high"]},
        "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "protected_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "allowed_command_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}},
        "required_tests": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}},
        "budget": {"$ref": "#/$defs/budget"},
        "merge_authority": {"const": "human"}
      }
    }
  }
}
