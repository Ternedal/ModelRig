{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaliv-rsi-dc-l16-runtime-preflight-attestation/v1",
  "title": "DC-L16 runtime preflight host attestation claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet",
    "packet_sha256",
    "attestation_id",
    "observer_host_id",
    "attested_at_utc",
    "feature_flag_off_verified",
    "pilot_runtime_verified",
    "native_windows_isolation_verified",
    "trusted_git_closure_verified",
    "kill_switch_prearmed",
    "restart_revoke_prearmed",
    "network_write_block_verified",
    "credentials_absent_verified",
    "unattended_cadence_forbidden_verified",
    "off_state_import_block_verified",
    "exact_source_binding_verified",
    "receipt_binding_verified",
    "host_attestation_verified",
    "integration_ready",
    "preflight_observed",
    "preflight_satisfied",
    "pilot_start_authorized",
    "product_pilot_started",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-runtime-preflight-attestation/v1"},
    "packet": {"type": "object"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestation_id": {"type": "string", "minLength": 1},
    "observer_host_id": {"type": "string", "minLength": 1},
    "attested_at_utc": {"type": "string", "minLength": 1},
    "feature_flag_off_verified": {"type": "boolean"},
    "pilot_runtime_verified": {"type": "boolean"},
    "native_windows_isolation_verified": {"type": "boolean"},
    "trusted_git_closure_verified": {"type": "boolean"},
    "kill_switch_prearmed": {"type": "boolean"},
    "restart_revoke_prearmed": {"type": "boolean"},
    "network_write_block_verified": {"type": "boolean"},
    "credentials_absent_verified": {"type": "boolean"},
    "unattended_cadence_forbidden_verified": {"type": "boolean"},
    "off_state_import_block_verified": {"type": "boolean"},
    "exact_source_binding_verified": {"type": "boolean"},
    "receipt_binding_verified": {"type": "boolean"},
    "host_attestation_verified": {"const": false},
    "integration_ready": {"const": false},
    "preflight_observed": {"const": false},
    "preflight_satisfied": {"const": false},
    "pilot_start_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "local_commit_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "dc-l16-runtime-preflight-attestation-claim-only"}
  }
}
