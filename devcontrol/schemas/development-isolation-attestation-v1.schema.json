{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-isolation-attestation-v1.json",
  "title": "Kaliv development isolation attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "task_sha256",
    "repository",
    "base_sha",
    "catalog_sha256",
    "toolchain_sha256",
    "boundary",
    "network_mode",
    "evidence_sha256"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-isolation-attestation/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundary": {"const": "os_isolated"},
    "network_mode": {"const": "deny"},
    "evidence_sha256": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
