{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-trusted-git-runtime-manifest-v1.json",
  "title": "Kaliv development trusted Git runtime manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executable_relative_path",
    "exec_path_relative_path",
    "path_relative_directories",
    "files"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-trusted-git-runtime-manifest/v1"},
    "executable_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "exec_path_relative_path": {
      "type": "string",
      "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "path_relative_directories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "size_bytes",
          "executable",
          "role"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "executable": {"type": "boolean"},
          "role": {"enum": ["executable", "helper", "library", "data"]}
        }
      }
    }
  }
}
