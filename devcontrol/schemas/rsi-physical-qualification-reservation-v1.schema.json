{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-qualification-reservation-v1.schema.json",
  "title": "ModelRig RSI physical qualification reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_scope",
    "ledger_root_path_sha256",
    "repository_root_path_sha256",
    "snapshot_receipt_sha256",
    "git_runtime_manifest_sha256",
    "git_executable_sha256",
    "request_id",
    "request_sha256",
    "qualification_packet_sha256",
    "signature_sha256",
    "requester_actor_id",
    "requested_main_sha",
    "observed_main_sha",
    "main_observation_sha256",
    "observed_at_utc",
    "consumed_at_utc",
    "collector_actor_id",
    "approver_actor_id",
    "main_head_match_confirmed",
    "request_consumed",
    "host_replay_guard_committed",
    "global_replay_safe",
    "frozen_main_confirmed",
    "physical_campaign_completed",
    "campaign_start_authorized",
    "pilot_go_authorized",
    "activation_authorized",
    "remote_publication_authorized",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-qualification-reservation/v1"},
    "ledger_scope": {
      "const": "canonical-host-local-v1",
      "description": "Canonical host-local replay/recovery state. This scope does not imply distributed/global replay safety or authority against a compromised host-administrator principal."
    },
    "ledger_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requester_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "main_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "consumed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "collector_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "main_head_match_confirmed": {"const": true},
    "request_consumed": {
      "const": true,
      "description": "The authenticated transaction consumed the request at commit time. Durable replay protection is only as strong as the separately attested host-admin-controlled ledger boundary."
    },
    "host_replay_guard_committed": {
      "const": true,
      "description": "A create-once replay marker was durably committed in the canonical host-admin-controlled ledger for this transaction. This does not assert rollback resistance against a compromised host-administrator/root principal or distributed/global one-time use.",
      "x-modelrig-host-admin-compromise-resistant": false
    },
    "global_replay_safe": {
      "const": false,
      "description": "No distributed/global replay guarantee is granted by this receipt."
    },
    "frozen_main_confirmed": {"const": false},
    "physical_campaign_completed": {"const": false},
    "campaign_start_authorized": {"const": false},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "authority": {"const": "consumed-request-evidence-only"}
  }
}
