{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/development-publisher-postcondition-receipt-v1.schema.json",
  "title": "Publisher postcondition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preflight",
    "preflight_sha256",
    "lease_sha256",
    "replay_entry_sha256",
    "request_sha256",
    "invocation_nonce",
    "remote_repository_sha256",
    "credential_policy_sha256",
    "observed_at_utc",
    "execution_state",
    "postconditions_verified",
    "repository_state_observed",
    "network_state_observed",
    "repository_write_performed",
    "network_write_performed",
    "commit_created",
    "branch_created",
    "branch_pushed",
    "pull_request_created",
    "ready_for_review",
    "reviewers_requested",
    "merged",
    "released",
    "deployed",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-publisher-postcondition-receipt/v1"},
    "preflight": {"type": "object"},
    "preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lease_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invocation_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "remote_repository_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "credential_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "execution_state": {"const": "not_executed"},
    "postconditions_verified": {"const": false},
    "repository_state_observed": {"const": false},
    "network_state_observed": {"const": false},
    "repository_write_performed": {"const": false},
    "network_write_performed": {"const": false},
    "commit_created": {"const": false},
    "branch_created": {"const": false},
    "branch_pushed": {"const": false},
    "pull_request_created": {"const": false},
    "ready_for_review": {"const": false},
    "reviewers_requested": {"const": false},
    "merged": {"const": false},
    "released": {"const": false},
    "deployed": {"const": false},
    "merge_authority": {"const": "human"}
  }
}
