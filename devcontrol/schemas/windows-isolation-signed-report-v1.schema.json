{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-windows-isolation-signed-report-v1.json",
  "title": "Kaliv signed Windows isolation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report",
    "key_id",
    "signature_algorithm",
    "signature_sha256"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-windows-isolation-signed-report/v1"
    },
    "report": {
      "$ref": "windows-isolation-physical-report-v1.schema.json"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "signature_algorithm": {
      "const": "hmac-sha256"
    },
    "signature_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
