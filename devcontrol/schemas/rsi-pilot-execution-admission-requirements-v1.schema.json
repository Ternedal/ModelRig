{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-execution-admission-requirements-v1.schema.json",
  "title": "DC-L16 pilot execution admission requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "start_receipt",
    "start_receipt_sha256",
    "authorization_proof_sha256",
    "fresh_authorization_proof_sha256",
    "authorization_signature_sha256",
    "preflight_signature_sha256",
    "start_nonce_sha256",
    "ledger_root_path_sha256",
    "repository",
    "base_sha",
    "requested_main_sha",
    "trial_id",
    "operator_surface",
    "selected_pilot_task_id",
    "workspace_root_path_sha256",
    "local_commits_allowed_by_human_scope",
    "host_ledger_revalidation_required",
    "fresh_upstream_authority_reverification_required",
    "allowlisted_task_registry_required",
    "exact_selected_task_required",
    "canonical_workspace_revalidation_required",
    "feature_flag_enabled_observation_required",
    "native_windows_isolation_required",
    "trusted_git_closure_required",
    "kill_switch_armed_required",
    "revoke_not_asserted_required",
    "restart_recovery_proof_required",
    "network_write_blocked_required",
    "credentials_absent_required",
    "unattended_cadence_forbidden",
    "general_shell_forbidden",
    "model_defined_commands_forbidden",
    "exact_source_base_head_binding_required",
    "exact_toolchain_binding_required",
    "execution_receipt_required",
    "manual_operator_invocation_required",
    "execution_admission_observed",
    "task_execution_authorized",
    "integration_ready",
    "product_pilot_started",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority",
    "schema"
  ],
  "properties": {
    "start_receipt": {"$ref": "rsi-pilot-start-consumption-receipt-v1.schema.json"},
    "start_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fresh_authorization_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "start_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trial_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "operator_surface": {"type": "string", "minLength": 3, "maxLength": 128},
    "selected_pilot_task_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "workspace_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_commits_allowed_by_human_scope": {"type": "boolean"},
    "host_ledger_revalidation_required": {"const": true},
    "fresh_upstream_authority_reverification_required": {"const": true},
    "allowlisted_task_registry_required": {"const": true},
    "exact_selected_task_required": {"const": true},
    "canonical_workspace_revalidation_required": {"const": true},
    "feature_flag_enabled_observation_required": {"const": true},
    "native_windows_isolation_required": {"const": true},
    "trusted_git_closure_required": {"const": true},
    "kill_switch_armed_required": {"const": true},
    "revoke_not_asserted_required": {"const": true},
    "restart_recovery_proof_required": {"const": true},
    "network_write_blocked_required": {"const": true},
    "credentials_absent_required": {"const": true},
    "unattended_cadence_forbidden": {"const": true},
    "general_shell_forbidden": {"const": true},
    "model_defined_commands_forbidden": {"const": true},
    "exact_source_base_head_binding_required": {"const": true},
    "exact_toolchain_binding_required": {"const": true},
    "execution_receipt_required": {"const": true},
    "manual_operator_invocation_required": {"const": true},
    "execution_admission_observed": {"const": false},
    "task_execution_authorized": {"const": false},
    "integration_ready": {"const": false},
    "product_pilot_started": {"const": false},
    "local_commit_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "dc-l16-pilot-execution-admission-requirements-only"},
    "schema": {"const": "kaliv-rsi-dc-l16-pilot-execution-admission-requirements/v1"}
  }
}
