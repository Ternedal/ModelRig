    "fresh_live_consumption_revalidation_required": {"const": true},
    "fresh_human_task_execution_authorization_required": {"const": true},
    "one_shot_execution_nonce_required": {"const": true},
    "host_local_execution_admission_ledger_required": {"const": true},
    "exact_allowlisted_task_registry_entry_required": {"const": true},
    "exact_selected_task_required": {"const": true},
    "canonical_workspace_revalidation_required": {"const": true},
    "exact_source_base_head_binding_required": {"const": true},
    "exact_toolchain_binding_required": {"const": true},
    "feature_flag_enabled_reobservation_required": {"const": true},
    "native_windows_isolation_revalidation_required": {"const": true},
    "trusted_git_closure_revalidation_required": {"const": true},
    "kill_switch_armed_revalidation_required": {"const": true},
    "revoke_not_asserted_revalidation_required": {"const": true},
    "restart_recovery_revalidation_required": {"const": true},
    "network_write_blocked_revalidation_required": {"const": true},
    "credentials_absent_revalidation_required": {"const": true},
    "general_shell_forbidden": {"const": true},
    "model_defined_commands_forbidden": {"const": true},
    "unattended_cadence_forbidden": {"const": true},
    "exact_fixed_command_plan_required": {"const": true},
    "bounded_execution_budget_required": {"const": true},
    "manual_operator_invocation_required": {"const": true},
    "post_execution_receipt_required": {"const": true},
    "task_execution_admission_observed": {"const": false},
    "task_execution_authorized": {"const": false},
    "task_execution_started": {"const": false},
    "integration_ready": {"const": false},
    "product_pilot_started": {"const": false},
    "local_commit_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "dc-l16-exact-task-execution-admission-requirements-only"},
    "schema": {"const": "kaliv-rsi-dc-l16-exact-task-execution-admission-requirements/v1"}
