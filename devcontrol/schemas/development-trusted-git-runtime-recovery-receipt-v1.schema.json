{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-trusted-git-runtime-recovery-receipt-v1.json",
  "title": "Kaliv development trusted Git runtime recovery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transaction_id",
    "manifest_sha256",
    "staging_root_path_sha256",
    "recovery_authorization_sha256",
    "operator_actor_id",
    "recovered_at_utc",
    "action",
    "state_before",
    "state_after",
    "final_root_verified"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-development-trusted-git-runtime-recovery-receipt/v1"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^git-runtime-[0-9a-f]{32}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "staging_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"
    },
    "recovered_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "action": {
      "enum": [
        "publish_prepared",
        "discard_pending",
        "release_reservation",
        "acknowledge_committed"
      ]
    },
    "state_before": {
      "enum": [
        "absent",
        "reserved",
        "partial",
        "prepared",
        "committed",
        "committed_locked",
        "conflict"
      ]
    },
    "state_after": {
      "enum": [
        "absent",
        "reserved",
        "partial",
        "prepared",
        "committed",
        "committed_locked",
        "conflict"
      ]
    },
    "final_root_verified": {"type": "boolean"}
  }
}
