{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/development-semantic-review-request-v1.schema.json",
  "title": "Kaliv Development Semantic Review Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "task_sha256",
    "repository",
    "base_sha",
    "developer_actor_id",
    "command_id",
    "execution_authority_sha256",
    "review_policy_sha256",
    "staged_patch_base64",
    "staged_patch_sha256",
    "staged_patch_bytes",
    "acceptance_criteria",
    "receipt",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-development-semantic-review-request/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "const": "Ternedal/ModelRig"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "developer_actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "execution_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "staged_patch_base64": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "staged_patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "staged_patch_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "receipt": {
      "type": "object"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
