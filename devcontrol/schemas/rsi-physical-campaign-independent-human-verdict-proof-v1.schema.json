{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-independent-human-verdict-proof-v1.schema.json",
  "title": "ModelRig RSI verified independent human DC-L15 completion proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "verdict_sha256", "signature_sha256", "key_id", "issuer_actor_id",
    "issuer_system_id", "main_freeze_proof_sha256", "execution_proof_sha256",
    "evidence_snapshot_sha256", "admission_sha256", "campaign_id", "task_id",
    "task_sha256", "repository", "base_sha", "requested_main_sha", "operator_actor_id",
    "approver_actor_id", "reviewer_actor_id", "verdict_id", "decision", "findings",
    "reviewed_at_utc", "verified_at_utc", "independent_human_verdict_verified",
    "runner_execution_binding_proven", "continuous_main_freeze_proven",
    "physical_campaign_completed", "dc_l15_complete",
    "dc_l14_independent_human_verdict_required", "human_pilot_go_required",
    "pilot_go_authorized", "activation_authorized", "remote_publication_authorized",
    "remaining_completion_gates", "authority"
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-independent-human-verdict-proof/v1"},
    "verdict_sha256": {"$ref": "#/$defs/sha64"},
    "signature_sha256": {"$ref": "#/$defs/sha64"},
    "key_id": {"$ref": "#/$defs/identifier"},
    "issuer_actor_id": {"$ref": "#/$defs/actor"},
    "issuer_system_id": {"const": "kaliv-rsi-dc-l15-independent-human-verdict-authority-v1"},
    "main_freeze_proof_sha256": {"$ref": "#/$defs/sha64"},
    "execution_proof_sha256": {"$ref": "#/$defs/sha64"},
    "evidence_snapshot_sha256": {"$ref": "#/$defs/sha64"},
    "admission_sha256": {"$ref": "#/$defs/sha64"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"$ref": "#/$defs/sha64"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "requested_main_sha": {"$ref": "#/$defs/sha40"},
    "operator_actor_id": {"$ref": "#/$defs/actor"},
    "approver_actor_id": {"$ref": "#/$defs/actor"},
    "reviewer_actor_id": {"$ref": "#/$defs/actor"},
    "verdict_id": {"$ref": "#/$defs/identifier"},
    "decision": {"const": "approve"},
    "findings": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "reviewed_at_utc": {"$ref": "#/$defs/utc"},
    "verified_at_utc": {"$ref": "#/$defs/utc"},
    "independent_human_verdict_verified": {"const": true},
    "runner_execution_binding_proven": {"const": true},
    "continuous_main_freeze_proven": {"const": true},
    "physical_campaign_completed": {"const": true},
    "dc_l15_complete": {"const": true},
    "dc_l14_independent_human_verdict_required": {"const": false},
    "human_pilot_go_required": {"const": true},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "remaining_completion_gates": {"const": ["human_pilot_go_decision"]},
    "authority": {"const": "verified-independent-human-dc-l15-completion-only"}
  }
}
