{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-admission-v1.schema.json",
  "title": "ModelRig RSI physical campaign admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admission_id",
    "campaign_id",
    "reservation_sha256",
    "request_id",
    "request_sha256",
    "request_signature_sha256",
    "requester_actor_id",
    "qualification_packet_sha256",
    "proposal_id",
    "task_id",
    "task_sha256",
    "repository",
    "base_sha",
    "requested_main_sha",
    "reservation_observation_sha256",
    "pre_start_observation_sha256",
    "repository_root_path_sha256",
    "git_runtime_manifest_sha256",
    "git_executable_sha256",
    "reservation_consumed_at_utc",
    "pre_start_observed_at_utc",
    "admitted_at_utc",
    "collector_actor_id",
    "approver_actor_id",
    "operator_actor_id",
    "required_report_schema",
    "required_boundary",
    "required_network_mode",
    "required_probes",
    "manual_operator_required",
    "single_campaign_only",
    "automatic_start",
    "campaign_start_authorized",
    "physical_campaign_completed",
    "post_campaign_main_observation_required",
    "frozen_main_confirmed",
    "pilot_go_authorized",
    "activation_authorized",
    "remote_publication_authorized",
    "authority",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-admission/v1"},
    "admission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "reservation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requester_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "qualification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reservation_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_start_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reservation_consumed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "pre_start_observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "admitted_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "collector_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "operator_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "required_report_schema": {"const": "kaliv-windows-isolation-physical-report/v1"},
    "required_boundary": {"const": "os_isolated"},
    "required_network_mode": {"const": "deny"},
    "required_probes": {
      "type": "array",
      "prefixItems": [
        {"const": "restricted_token"},
        {"const": "workspace_allowed"},
        {"const": "workspace_escape_denied"},
        {"const": "network_denied"},
        {"const": "process_tree_timeout_cleanup"},
        {"const": "process_tree_crash_cleanup"},
        {"const": "cancel_cleanup"},
        {"const": "reboot_cleanup"},
        {"const": "memory_limit_enforced"},
        {"const": "process_limit_enforced"},
        {"const": "existing_tools_compatible"}
      ],
      "items": false,
      "minItems": 11,
      "maxItems": 11
    },
    "manual_operator_required": {"const": true},
    "single_campaign_only": {"const": true},
    "automatic_start": {"const": false},
    "campaign_start_authorized": {"const": true},
    "physical_campaign_completed": {"const": false},
    "post_campaign_main_observation_required": {"const": true},
    "frozen_main_confirmed": {"const": false},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "authority": {"const": "single-physical-campaign-start-only"},
    "merge_authority": {"const": "human"}
  }
}
