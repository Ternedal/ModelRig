{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-promotion-receipt-v1.schema.json",
  "title": "ModelRig RSI promotion receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "proposal_sha256",
    "authorization_sha256",
    "authorization_signature_sha256",
    "task_id",
    "task_sha256",
    "repository",
    "base_sha",
    "reviewer_actor_id",
    "issuer_system_id",
    "verified_at_utc",
    "required_evals",
    "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-promotion-receipt/v1"},
    "proposal_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[^/\\\\s]+/[^/\\\\s]+$", "maxLength": 200},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewer_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "issuer_system_id": {"const": "modelrig-rsi-human-review"},
    "verified_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "required_evals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "authority": {"const": "human-signed-promotion"}
  }
}
