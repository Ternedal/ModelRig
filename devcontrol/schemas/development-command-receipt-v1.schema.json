{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-command-receipt-v1.json",
  "title": "Kaliv development command receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "task_sha256",
    "base_sha",
    "command_id",
    "argv_sha256",
    "cwd",
    "returncode",
    "stdout_sha256",
    "stderr_sha256",
    "output_bytes",
    "duration_ms",
    "workspace_before_sha256",
    "workspace_after_sha256",
    "workspace_unchanged",
    "workspace_reset",
    "passed"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-command-receipt/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cwd": {"type": "string", "minLength": 1, "maxLength": 512},
    "returncode": {"type": "integer"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_bytes": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0},
    "workspace_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_unchanged": {"type": "boolean"},
    "workspace_reset": {"type": "boolean"},
    "passed": {"type": "boolean"}
  }
}
