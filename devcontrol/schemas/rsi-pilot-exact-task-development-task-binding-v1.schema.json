{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/devcontrol/rsi-pilot-exact-task-development-task-binding-v1.schema.json",
  "title": "ModelRig RSI DC-L16 exact DevelopmentTask binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_requirements", "plan_requirements_sha256",
    "admission_receipt_sha256", "execution_nonce_sha256", "registry_sha256",
    "selected_pilot_task_id", "development_task", "development_task_id",
    "development_task_sha256", "fixed_command_id", "repository", "base_sha",
    "requested_main_sha", "workspace_root_path_sha256",
    "local_commits_allowed_by_human_scope", "host_registry_verified",
    "pilot_task_mapping_verified", "development_task_materialized",
    "single_fixed_command_verified", "execution_plan_materialized",
    "execution_consumed", "task_execution_started", "task_execution_completed",
    "integration_ready", "product_pilot_started", "local_commit_authorized",
    "remote_write_authorized", "push_authorized", "pr_mutation_authorized",
    "merge_authorized", "release_authorized", "deploy_authorized",
    "production_activation_authorized", "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-dc-l16-exact-task-development-task-binding/v1"},
    "plan_requirements": {"$ref": "rsi-pilot-exact-task-execution-plan-requirements-v1.schema.json"},
    "plan_requirements_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "admission_receipt_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "execution_nonce_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "selected_pilot_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "development_task": {"$ref": "rsi-pilot-exact-task-development-task-registry-v1.schema.json#/$defs/developmentTask"},
    "development_task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "development_task_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "fixed_command_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workspace_root_path_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "local_commits_allowed_by_human_scope": {"type": "boolean"},
    "host_registry_verified": {"const": true},
    "pilot_task_mapping_verified": {"const": true},
    "development_task_materialized": {"const": true},
    "single_fixed_command_verified": {"const": true},
    "execution_plan_materialized": {"const": false},
    "execution_consumed": {"const": false},
    "task_execution_started": {"const": false},
    "task_execution_completed": {"const": false},
    "integration_ready": {"const": false},
    "product_pilot_started": {"const": false},
    "local_commit_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "host-bound-one-exact-development-task-only"}
  }
}
