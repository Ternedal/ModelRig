{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-execution-proof-v1.schema.json",
  "title": "ModelRig RSI verified human exact-runner execution proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "binding_sha256", "evidence_snapshot_sha256", "signature_sha256", "key_id",
    "issuer_actor_id", "issuer_system_id", "binding_id", "admission_sha256", "campaign_id",
    "task_id", "task_sha256", "repository", "base_sha", "requested_main_sha",
    "runner_relative_path", "runner_sha256", "runner_bytes", "signed_report_sha256",
    "physical_report_sha256", "report_id", "operator_actor_id", "approver_actor_id",
    "execution_started_at_utc", "execution_completed_at_utc", "binding_created_at_utc",
    "verified_at_utc", "evidence_snapshot_binding_verified", "human_execution_signature_verified",
    "runner_execution_binding_proven", "continuous_main_freeze_proven",
    "physical_campaign_completed", "dc_l15_complete", "dc_l14_independent_human_verdict_required",
    "human_pilot_go_required", "pilot_go_authorized", "activation_authorized",
    "remote_publication_authorized", "remaining_completion_gates", "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-execution-proof/v1"},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "issuer_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "issuer_system_id": {"const": "kaliv-rsi-dc-l15-execution-binding-authority-v1"},
    "binding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_bytes": {"type": "integer", "minimum": 1, "maximum": 16000000},
    "signed_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "operator_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "execution_started_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "execution_completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "binding_created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "verified_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evidence_snapshot_binding_verified": {"const": true},
    "human_execution_signature_verified": {"const": true},
    "runner_execution_binding_proven": {"const": true},
    "continuous_main_freeze_proven": {"const": false},
    "physical_campaign_completed": {"const": false},
    "dc_l15_complete": {"const": false},
    "dc_l14_independent_human_verdict_required": {"const": true},
    "human_pilot_go_required": {"const": true},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "remaining_completion_gates": {
      "type": "array",
      "prefixItems": [
        {"const": "continuous_main_freeze_confirmation"},
        {"const": "dc_l14_independent_human_verdict"},
        {"const": "human_pilot_go_decision"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "authority": {"const": "verified-human-exact-runner-execution-binding-only"}
  }
}
