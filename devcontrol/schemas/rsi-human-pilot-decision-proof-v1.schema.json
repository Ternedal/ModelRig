{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-human-pilot-decision-proof-v1.schema.json",
  "title": "ModelRig RSI verified human pilot decision proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "decision_sha256", "signature_sha256", "key_id", "issuer_actor_id",
    "issuer_system_id", "completion_proof_sha256", "campaign_id", "task_id",
    "task_sha256", "repository", "base_sha", "requested_main_sha", "decision_id",
    "decision_maker_actor_id", "decision", "operator_surface", "allowed_task_ids",
    "workspace_root_path_sha256", "local_commits_allowed", "notes", "decided_at_utc",
    "verified_at_utc", "human_pilot_decision_recorded", "pilot_go_authorized",
    "product_pilot_started", "feature_flag_default_off", "remote_write_authorized",
    "merge_authorized", "release_authorized", "deploy_authorized",
    "production_activation_authorized", "authority"
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema": {"const": "kaliv-rsi-human-pilot-decision-proof/v1"},
    "decision_sha256": {"$ref": "#/$defs/sha64"},
    "signature_sha256": {"$ref": "#/$defs/sha64"},
    "key_id": {"$ref": "#/$defs/identifier"},
    "issuer_actor_id": {"$ref": "#/$defs/actor"},
    "issuer_system_id": {"const": "kaliv-rsi-dc-l16-human-pilot-decision-authority-v1"},
    "completion_proof_sha256": {"$ref": "#/$defs/sha64"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"$ref": "#/$defs/sha64"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "requested_main_sha": {"$ref": "#/$defs/sha40"},
    "decision_id": {"$ref": "#/$defs/identifier"},
    "decision_maker_actor_id": {"$ref": "#/$defs/actor"},
    "decision": {"enum": ["go", "no_go", "go_with_conditions"]},
    "operator_surface": {"$ref": "#/$defs/identifier"},
    "allowed_task_ids": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "workspace_root_path_sha256": {"$ref": "#/$defs/sha64"},
    "local_commits_allowed": {"type": "boolean"},
    "notes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "decided_at_utc": {"$ref": "#/$defs/utc"},
    "verified_at_utc": {"$ref": "#/$defs/utc"},
    "human_pilot_decision_recorded": {"const": true},
    "pilot_go_authorized": {"type": "boolean"},
    "product_pilot_started": {"const": false},
    "feature_flag_default_off": {"const": true},
    "remote_write_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "authority": {"const": "verified-human-dc-l16-pilot-decision-only"}
  }
}
