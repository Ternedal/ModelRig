{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-execution-binding-v1.schema.json",
  "title": "ModelRig RSI human exact-runner execution binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "binding_id", "evidence_snapshot_sha256", "admission_sha256", "campaign_id",
    "task_id", "task_sha256", "repository", "base_sha", "requested_main_sha",
    "runner_relative_path", "runner_sha256", "runner_bytes", "signed_report_sha256",
    "physical_report_sha256", "report_id", "operator_actor_id", "approver_actor_id",
    "report_started_at_utc", "report_completed_at_utc", "execution_started_at_utc",
    "execution_completed_at_utc", "post_main_observed_at_utc", "binding_created_at_utc",
    "exact_campaign_id_confirmed", "exact_runner_path_confirmed", "exact_runner_sha256_confirmed",
    "exact_runner_byte_count_confirmed", "exact_report_binding_confirmed",
    "continuous_main_freeze_confirmed", "dc_l14_independent_human_verdict",
    "human_pilot_go_decision", "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-execution-binding/v1"},
    "binding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_bytes": {"type": "integer", "minimum": 1, "maximum": 16000000},
    "signed_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "operator_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "report_started_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "report_completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "execution_started_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "execution_completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "post_main_observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "binding_created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "exact_campaign_id_confirmed": {"const": true},
    "exact_runner_path_confirmed": {"const": true},
    "exact_runner_sha256_confirmed": {"const": true},
    "exact_runner_byte_count_confirmed": {"const": true},
    "exact_report_binding_confirmed": {"const": true},
    "continuous_main_freeze_confirmed": {"const": false},
    "dc_l14_independent_human_verdict": {"const": false},
    "human_pilot_go_decision": {"const": false},
    "authority": {"const": "human-exact-runner-execution-claim-only"}
  }
}
