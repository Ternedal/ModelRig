{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/devcontrol/schemas/rsi-pilot-exact-task-pr-lifecycle-transaction-v1.schema.json",
  "title": "RSI Pilot Exact Task PR Lifecycle Transaction Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "transaction_ledger_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transaction_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pr_lifecycle_authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_publication_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "development_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pr_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "base_branch": {"type": "string", "minLength": 1},
    "head_branch": {"type": "string", "minLength": 1},
    "predicted_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "pull_request_api_url": {"type": "string", "minLength": 1},
    "pull_request_node_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_usernames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 20},
    "reviewer_team_slugs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 20},
    "publisher_credential_id": {"type": "string", "minLength": 1},
    "publisher_credential_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publisher_credential_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_ready_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at_utc": {"type": "string", "minLength": 1},
    "ready_at_utc": {"type": "string", "minLength": 1},
    "reviewers_requested_at_utc": {"type": "string", "minLength": 1},
    "completed_at_utc": {"type": "string", "minLength": 1},
    "host_transaction_guard_committed": {"const": true},
    "pr_lifecycle_authorization_authenticated": {"const": true},
    "pr_lifecycle_authorization_consumed": {"const": true},
    "exact_pr_revalidated_after_consumption": {"const": true},
    "ready_for_review_completed": {"const": true},
    "reviewer_requests_completed": {"const": true},
    "final_pr_state_verified": {"const": true},
    "remote_write_performed": {"const": true},
    "ready_for_review_authorized": {"const": false},
    "reviewer_request_authorized": {"const": false},
    "remote_write_authorized": {"const": false},
    "push_authorized": {"const": false},
    "pr_mutation_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "product_pilot_started": {"const": false},
    "draft": {"const": false},
    "nonce_reusable": {"const": false},
    "ledger_scope": {"const": "canonical-host-local-v1"},
    "authority": {"const": "host-executed-one-dc-l16-exact-pr-lifecycle-only"},
    "schema": {"const": "kaliv-rsi-dc-l16-exact-task-pr-lifecycle-transaction-receipt/v1"}
  },
  "required": [
    "transaction_ledger_root_path_sha256",
    "transaction_key_sha256",
    "pr_lifecycle_authorization_sha256",
    "post_publication_attestation_sha256",
    "lifecycle_config_sha256",
    "reviewer_set_sha256",
    "execution_nonce_sha256",
    "development_task_sha256",
    "candidate_patch_sha256",
    "pr_intent_sha256",
    "repository",
    "repository_id",
    "base_branch",
    "head_branch",
    "predicted_commit_sha",
