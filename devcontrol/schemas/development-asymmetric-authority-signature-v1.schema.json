{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-asymmetric-authority-signature-v1.json",
  "title": "Kaliv detached Ed25519 authority signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "key_id",
    "issuer_actor_id",
    "issuer_system_id",
    "keyring_epoch",
    "custody_policy_sha256",
    "payload_sha256",
    "signature_hex",
    "signed_at_utc"
  ],
  "properties": {
    "schema": {"const": "kaliv-asymmetric-authority-signature/v1"},
    "algorithm": {"const": "ed25519"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "issuer_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "issuer_system_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "keyring_epoch": {"type": "integer", "minimum": 1},
    "custody_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "signed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
