{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-qualification-request-v1.schema.json",
  "title": "ModelRig RSI physical qualification request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "qualification_packet_sha256",
    "proposal_id",
    "repository",
    "candidate_commit_sha",
    "candidate_tree_sha",
    "candidate_eval_sha256",
    "requested_frozen_main_sha",
    "required_report_schema",
    "required_boundary",
    "required_network_mode",
    "required_probes",
    "collector_actor_id",
    "approver_actor_id",
    "requested_at_utc",
    "expires_at_utc",
    "authority",
    "scope",
    "automatic_start",
    "pilot_authority",
    "activation_authority",
    "remote_publication_authority",
    "exact_frozen_main_confirmed",
    "physical_evidence_present"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-qualification-request/v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "qualification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "candidate_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_eval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_frozen_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "required_report_schema": {"const": "kaliv-windows-isolation-physical-report/v1"},
    "required_boundary": {"const": "os_isolated"},
    "required_network_mode": {"const": "deny"},
    "required_probes": {
      "const": [
        "restricted_token",
        "workspace_allowed",
        "workspace_escape_denied",
        "network_denied",
        "process_tree_timeout_cleanup",
        "process_tree_crash_cleanup",
        "cancel_cleanup",
        "reboot_cleanup",
        "memory_limit_enforced",
        "process_limit_enforced",
        "existing_tools_compatible"
      ]
    },
    "collector_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "requested_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authority": {"const": "human-signed-request-only"},
    "scope": {"const": "dc-l15-physical-validation-request-only"},
    "automatic_start": {"const": false},
    "pilot_authority": {"const": false},
    "activation_authority": {"const": false},
    "remote_publication_authority": {"const": false},
    "exact_frozen_main_confirmed": {"const": false},
    "physical_evidence_present": {"const": false}
  }
}
