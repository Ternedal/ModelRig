{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/kaliv-development-trusted-git-runtime-evidence-v1.json",
  "title": "Kaliv development trusted Git runtime evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_manifest_sha256",
    "runtime_file_count",
    "runtime_bytes",
    "executable_sha256",
    "version",
    "exec_path_relative_path",
    "path_relative_directories",
    "library_relative_directories"
  ],
  "properties": {
    "schema": {"const": "kaliv-development-trusted-git-runtime-evidence/v1"},
    "runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_file_count": {"type": "integer", "minimum": 1, "maximum": 50000},
    "runtime_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
    "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 512},
    "exec_path_relative_path": {
      "type": "string",
      "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "path_relative_directories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "library_relative_directories": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
