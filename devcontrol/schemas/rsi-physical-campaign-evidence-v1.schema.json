{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-physical-campaign-evidence-v1.schema.json",
  "title": "ModelRig RSI post-campaign physical evidence snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "admission_sha256", "campaign_id", "reservation_sha256", "request_sha256",
    "qualification_packet_sha256", "snapshot_receipt_sha256", "task_id", "task_sha256",
    "repository", "base_sha", "requested_main_sha", "runner_relative_path", "runner_sha256",
    "runner_bytes", "isolation_attestation_sha256", "signed_report_sha256", "physical_report_sha256",
    "report_id", "rig_id", "rig_fingerprint_sha256", "toolhost_sha256", "workspace_root_sha256",
    "collector_actor_id", "approver_actor_id", "report_started_at_utc", "report_completed_at_utc",
    "post_main_observation_sha256", "post_main_observed_sha", "post_main_observed_at_utc",
    "repository_root_path_sha256", "git_runtime_manifest_sha256", "git_executable_sha256",
    "physical_report_verified", "all_required_probes_passed", "collector_approver_separation_verified",
    "post_campaign_main_match_confirmed", "runner_execution_binding_proven", "continuous_main_freeze_proven",
    "physical_campaign_completed", "dc_l15_complete", "human_completion_binding_required",
    "dc_l14_independent_human_verdict_required", "human_pilot_go_required", "pilot_go_authorized",
    "activation_authorized", "remote_publication_authorized", "missing_completion_gates", "authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-physical-campaign-evidence-snapshot/v1"},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "reservation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "Ternedal/ModelRig"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_bytes": {"type": "integer", "minimum": 1, "maximum": 16000000},
    "isolation_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "rig_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "rig_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolhost_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collector_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "approver_actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,127}$"},
    "report_started_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "report_completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "post_main_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_main_observed_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "post_main_observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "repository_root_path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_report_verified": {"const": true},
    "all_required_probes_passed": {"const": true},
    "collector_approver_separation_verified": {"const": true},
    "post_campaign_main_match_confirmed": {"const": true},
    "runner_execution_binding_proven": {"const": false},
    "continuous_main_freeze_proven": {"const": false},
    "physical_campaign_completed": {"const": false},
    "dc_l15_complete": {"const": false},
    "human_completion_binding_required": {"const": true},
    "dc_l14_independent_human_verdict_required": {"const": true},
    "human_pilot_go_required": {"const": true},
    "pilot_go_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "remote_publication_authorized": {"const": false},
    "missing_completion_gates": {
      "type": "array",
      "prefixItems": [
        {"const": "exact_runner_execution_binding"},
        {"const": "continuous_main_freeze_confirmation"},
        {"const": "dc_l14_independent_human_verdict"},
        {"const": "human_pilot_go_decision"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "authority": {"const": "verified-physical-evidence-only"}
  }
}
