{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-exact-task-product-pilot-execution-recovery-resolution-v1.schema.json",
  "title": "ModelRig product-pilot execution recovery resolution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recovery_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_nonce_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_ledger_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_snapshot_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executor_capability_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_admission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixed_command_id": {
      "const": "modelrig.version.check"
    },
    "source_recovery_state_class": {
      "enum": [
        "completed_verified",
        "receipt_publication_uncertain",
        "consumed_uncertain"
      ]
    },
    "recovered_execution_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution_class": {
      "enum": [
        "completed_ready_for_post_restart_verification",
        "pending_receipt_manual_resolution_required",
        "consumed_uncertain_manual_resolution_required"
      ]
    },
    "recovery_authenticated_at_resolution": {
      "const": true
    },
    "resolution_evidence_verified": {
      "const": true
    },
    "execution_nonce_consumed": {
      "const": true
    },
    "completed_execution_evidence_available": {
      "type": "boolean"
    },
    "post_restart_verification_required": {
      "type": "boolean"
    },
    "manual_intervention_required": {
      "type": "boolean"
    },
    "retry_authorized": {
      "const": false
    },
    "task_execution_authorized": {
      "const": false
    },
    "local_commit_authorized": {
      "const": false
    },
    "remote_write_authorized": {
      "const": false
    },
    "push_authorized": {
      "const": false
    },
    "pr_mutation_authorized": {
      "const": false
    },
    "merge_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "deploy_authorized": {
      "const": false
    },
    "production_activation_authorized": {
      "const": false
    },
    "nonce_reusable": {
      "const": false
    },
    "next_boundary_post_restart_verification_required": {
      "type": "boolean"
    },
    "next_boundary_manual_resolution_required": {
      "type": "boolean"
    },
    "resolution_scope": {
      "const": "adr-dc-110-recovery-disposition-v1"
    },
    "authority": {
      "const": "live-recovery-disposition-no-retry-only"
    },
    "schema": {
      "const": "kaliv-rsi-dc-l16-exact-task-product-pilot-execution-recovery-resolution/v1"
    }
  },
  "required": [
    "recovery_receipt_sha256",
    "recovery_observation_sha256",
    "execution_nonce_sha256",
    "execution_ledger_root_path_sha256",
    "execution_lock_sha256",
    "execution_plan_sha256",
    "workspace_snapshot_receipt_sha256",
    "executor_capability_sha256",
    "execution_admission_sha256",
    "development_task_sha256",
    "workspace_snapshot_sha256",
    "fixed_command_id",
    "source_recovery_state_class",
    "recovered_execution_receipt_sha256",
    "resolution_class",
    "recovery_authenticated_at_resolution",
    "resolution_evidence_verified",
    "execution_nonce_consumed",
    "completed_execution_evidence_available",
    "post_restart_verification_required",
    "manual_intervention_required",
    "retry_authorized",
    "task_execution_authorized",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "nonce_reusable",
    "next_boundary_post_restart_verification_required",
    "next_boundary_manual_resolution_required",
    "resolution_scope",
    "authority",
    "schema"
  ]
}
