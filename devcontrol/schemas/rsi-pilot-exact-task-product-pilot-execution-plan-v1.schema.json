{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-exact-task-product-pilot-execution-plan-v1.schema.json",
  "title": "ModelRig product-pilot frozen-snapshot execution plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_snapshot_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executor_capability_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_admission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_nonce_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_task_id": {
      "type": "string",
      "minLength": 1
    },
    "development_task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_task_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixed_command_id": {
      "const": "modelrig.version.check"
    },
    "command_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "const": "Ternedal/ModelRig"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "merge_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workspace_root_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_root_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lease_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "physical_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signed_runtime_closure_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_closure_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_git_runtime_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_git_runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolhost_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "staged_patch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "staged_patch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "unstaged_patch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unstaged_patch_bytes": {
          "const": 0
        },
        "untracked_paths_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "untracked_path_count": {
          "const": 0
        },
        "schema": {
          "const": "kaliv-development-git-workspace-snapshot/v1"
        }
      },
      "required": [
        "head_sha",
        "staged_patch_sha256",
        "staged_patch_bytes",
        "unstaged_patch_sha256",
        "unstaged_patch_bytes",
        "untracked_paths_sha256",
        "untracked_path_count",
        "schema"
      ]
    },
    "task_max_runtime_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "task_max_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 33554432
    },
    "process_memory_bytes": {
      "const": 536870912
    },
    "active_process_limit": {
      "const": 8
    },
    "product_pilot_started": {
      "const": true
    },
    "workspace_snapshot_authenticated": {
      "const": true
    },
    "exact_workspace_snapshot_bound": {
      "const": true
    },
    "command_specification_bound": {
      "const": true
    },
    "execution_plan_materialized": {
      "const": true
    },
    "task_execution_authorized": {
      "const": true
    },
    "one_shot_task_execution_required": {
      "const": true
    },
    "pre_launch_substrate_revalidation_required": {
      "const": true
    },
    "pre_launch_workspace_snapshot_revalidation_required": {
      "const": true
    },
    "task_execution_started": {
      "const": false
    },
    "task_execution_completed": {
      "const": false
    },
    "local_commit_authorized": {
      "const": false
    },
    "remote_write_authorized": {
      "const": false
    },
    "push_authorized": {
      "const": false
    },
    "pr_mutation_authorized": {
      "const": false
    },
    "merge_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "deploy_authorized": {
      "const": false
    },
    "production_activation_authorized": {
      "const": false
    },
    "nonce_reusable": {
      "const": false
    },
    "next_boundary_task_execution_required": {
      "const": true
    },
    "plan_scope": {
      "const": "started-product-pilot-reviewed-version-check-frozen-snapshot-plan-v1"
    },
    "authority": {
      "const": "live-product-pilot-frozen-snapshot-execution-plan-only"
    },
    "schema": {
      "const": "kaliv-rsi-dc-l16-exact-task-product-pilot-execution-plan/v1"
    }
  },
  "required": [
    "workspace_snapshot_receipt_sha256",
    "executor_capability_sha256",
    "execution_admission_sha256",
    "execution_nonce_sha256",
    "development_task_id",
    "development_task_sha256",
    "development_task_base_sha",
    "fixed_command_id",
    "command_spec_sha256",
    "repository",
    "repository_id",
    "merge_commit_sha",
    "workspace_root_path_sha256",
    "workspace_root_authority_sha256",
    "catalog_sha256",
    "toolchain_sha256",
    "lease_sha256",
    "physical_report_sha256",
    "signed_runtime_closure_sha256",
    "runtime_closure_manifest_sha256",
    "trusted_git_runtime_receipt_sha256",
    "trusted_git_runtime_manifest_sha256",
    "toolhost_sha256",
    "source_environment_sha256",
    "workspace_snapshot_sha256",
    "workspace_snapshot",
    "task_max_runtime_seconds",
    "task_max_output_bytes",
    "process_memory_bytes",
    "active_process_limit",
    "product_pilot_started",
    "workspace_snapshot_authenticated",
    "exact_workspace_snapshot_bound",
    "command_specification_bound",
    "execution_plan_materialized",
    "task_execution_authorized",
    "one_shot_task_execution_required",
    "pre_launch_substrate_revalidation_required",
    "pre_launch_workspace_snapshot_revalidation_required",
    "task_execution_started",
    "task_execution_completed",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "nonce_reusable",
    "next_boundary_task_execution_required",
    "plan_scope",
    "authority",
    "schema"
  ]
}
