    "exact_commit_object_verified": {"type": "boolean", "const": true},
    "local_ref_create_only_cas_succeeded": {"type": "boolean", "const": true},
    "post_write_ref_verified": {"type": "boolean", "const": true},
    "post_write_workspace_revalidated": {"type": "boolean", "const": true},
    "write_reservation_consumed": {"type": "boolean", "const": true},
    "local_commit_write_completed": {"type": "boolean", "const": true},
    "git_object_write_performed": {"type": "boolean", "const": true},
    "local_ref_update_performed": {"type": "boolean", "const": true},
    "local_commit_created": {"type": "boolean", "const": true},
    "git_object_write_authorized": {"type": "boolean", "const": false},
    "local_ref_update_authorized": {"type": "boolean", "const": false},
    "local_commit_authorized": {"type": "boolean", "const": false},
    "integration_ready": {"type": "boolean", "const": false},
    "product_pilot_started": {"type": "boolean", "const": false},
    "remote_write_authorized": {"type": "boolean", "const": false},
    "push_authorized": {"type": "boolean", "const": false},
    "pr_mutation_authorized": {"type": "boolean", "const": false},
    "merge_authorized": {"type": "boolean", "const": false},
    "release_authorized": {"type": "boolean", "const": false},
    "deploy_authorized": {"type": "boolean", "const": false},
    "production_activation_authorized": {"type": "boolean", "const": false},
    "authority": {"type": "string", "const": "host-completed-one-dc-l16-exact-local-commit-only"},
    "ledger_scope": {"type": "string", "const": "canonical-host-local-v1"},
    "schema": {"type": "string", "const": "kaliv-rsi-dc-l16-exact-task-local-commit-write-transaction-receipt/v1"}
