    "transaction_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "write_reservation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_commit_object_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
