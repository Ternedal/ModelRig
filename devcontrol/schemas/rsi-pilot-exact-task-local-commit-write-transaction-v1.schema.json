    "local_write_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "local_ref": {"type": "string", "pattern": "^refs/modelrig/rsi/local-commit/[0-9a-f]{64}$"},
    "expected_old_ref_sha": {"type": "string", "const": "0000000000000000000000000000000000000000"},
    "index_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
