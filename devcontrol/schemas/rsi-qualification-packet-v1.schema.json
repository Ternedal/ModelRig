{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.invalid/schemas/rsi-qualification-packet-v1.schema.json",
  "title": "ModelRig RSI qualification packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "proposal_id",
    "repository",
    "base_sha",
    "proposal_sha256",
    "promotion_receipt_sha256",
    "task_id",
    "task_sha256",
    "materialization_receipt_sha256",
    "snapshot_receipt_sha256",
    "candidate_commit_sha",
    "candidate_tree_sha",
    "worker_code_sha256",
    "baseline_eval_sha256",
    "candidate_eval_sha256",
    "regression_proof_sha256",
    "runtime_provenance_sha256",
    "required_evals",
    "software_chain_complete",
    "ready_for_human_go",
    "activation_authorized",
    "automatic_activation",
    "remote_publication_authorized",
    "fresh_physical_evidence_required",
    "independent_collector_approver_required",
    "missing_physical_gates",
    "authority",
    "merge_authority"
  ],
  "properties": {
    "schema": {"const": "kaliv-rsi-qualification-packet/v1"},
    "phase": {"const": "pre-dc-l15-physical-qualification"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "repository": {"type": "string", "pattern": "^[^/\\\\s]+/[^/\\\\s]+$", "maxLength": 200},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "promotion_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worker_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_eval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_eval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "regression_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_evals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "software_chain_complete": {"const": true},
    "ready_for_human_go": {"const": false},
    "activation_authorized": {"const": false},
    "automatic_activation": {"const": false},
    "remote_publication_authorized": {"const": false},
    "fresh_physical_evidence_required": {"const": true},
    "independent_collector_approver_required": {"const": true},
    "missing_physical_gates": {
      "const": [
        "dc_l14_independent_human_verdict",
        "exact_frozen_main_head_confirmation",
        "fresh_physical_i0b_campaign",
        "independent_physical_collector_approver",
        "human_pilot_go_decision"
      ]
    },
    "authority": {"const": "evidence-only"},
    "merge_authority": {"const": "human"}
  }
}
