{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/schemas/rsi-pilot-runtime-preflight-observation-packet-v1.schema.json",
  "title": "DC-L16 runtime preflight observation packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_proof",
    "selection_proof_sha256",
    "preflight_requirements",
    "preflight_requirements_sha256",
    "observation_id",
    "observer_actor_id",
    "observed_at_utc",
    "feature_flag_off_evidence_sha256",
    "pilot_runtime_evidence_sha256",
    "native_windows_isolation_evidence_sha256",
    "trusted_git_closure_evidence_sha256",
    "kill_switch_prearm_evidence_sha256",
    "restart_revoke_prearm_evidence_sha256",
    "network_write_block_evidence_sha256",
    "credentials_absent_evidence_sha256",
    "unattended_cadence_evidence_sha256",
    "off_state_import_block_evidence_sha256",
    "exact_source_binding_evidence_sha256",
    "receipt_binding_evidence_sha256",
    "observation_set_complete",
    "evidence_verified",
    "integration_ready",
    "preflight_observed",
    "preflight_satisfied",
    "pilot_start_authorized",
    "product_pilot_started",
    "local_commit_authorized",
    "remote_write_authorized",
    "push_authorized",
    "pr_mutation_authorized",
    "merge_authorized",
    "release_authorized",
    "deploy_authorized",
    "production_activation_authorized",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-rsi-dc-l16-runtime-preflight-observation-packet/v1"
    },
    "selection_proof": {
      "type": "object"
    },
    "selection_proof_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preflight_requirements": {
      "type": "object"
    },
    "preflight_requirements_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation_id": {
      "$ref": "#/$defs/id"
    },
    "observer_actor_id": {
      "$ref": "#/$defs/id"
    },
    "observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "feature_flag_off_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "pilot_runtime_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "native_windows_isolation_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "trusted_git_closure_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "kill_switch_prearm_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "restart_revoke_prearm_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "network_write_block_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "credentials_absent_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "unattended_cadence_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "off_state_import_block_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "exact_source_binding_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_binding_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "observation_set_complete": { "const": true },
    "evidence_verified": { "const": false },
    "integration_ready": { "const": false },
    "preflight_observed": { "const": false },
    "preflight_satisfied": { "const": false },
    "pilot_start_authorized": { "const": false },
    "product_pilot_started": { "const": false },
    "local_commit_authorized": { "const": false },
    "remote_write_authorized": { "const": false },
    "push_authorized": { "const": false },
    "pr_mutation_authorized": { "const": false },
    "merge_authorized": { "const": false },
    "release_authorized": { "const": false },
    "deploy_authorized": { "const": false },
    "production_activation_authorized": { "const": false },
    "authority": {
      "const": "dc-l16-runtime-preflight-observation-packet-only"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    }
  }
}
