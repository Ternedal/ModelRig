{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/contracts/consciousness-core/thought-proposal-v1.schema.json",
  "title": "Kaliv Consciousness Core ThoughtProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "request_id",
    "interpretation",
    "hypotheses",
    "candidate_intentions",
    "predicted_outcomes",
    "questions",
    "memory_queries",
    "attention_suggestions",
    "response_intent",
    "body_intent",
    "uncertainty",
    "state_mutations",
    "actions",
    "authority",
    "production_activation"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-consciousness-core/thought-proposal/v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^thinkprop-[a-f0-9]{32}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^thinkreq-[a-f0-9]{32}$"
    },
    "interpretation": {
      "type": "string",
      "maxLength": 8192
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "confidence"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "candidate_intentions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "confidence",
          "required_authority"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "required_authority": {
            "enum": [
              "none",
              "agent3",
              "bodyrig",
              "voicerig",
              "memory4",
              "human_review"
            ]
          }
        }
      }
    },
    "predicted_outcomes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "confidence"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "memory_queries": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "attention_suggestions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "response_intent": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "body_intent": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "state_mutations": {
      "type": "array",
      "maxItems": 0
    },
    "actions": {
      "type": "array",
      "maxItems": 0
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "persistent_state",
        "durable_memory",
        "action"
      ],
      "properties": {
        "identity": {
          "const": false
        },
        "persistent_state": {
          "const": false
        },
        "durable_memory": {
          "const": false
        },
        "action": {
          "const": false
        }
      }
    },
    "production_activation": {
      "const": false
    }
  }
}
