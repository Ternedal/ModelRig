{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/contracts/consciousness-core/world-state-v1.schema.json",
  "title": "Kaliv Consciousness Core WorldState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "world_id",
    "revision",
    "observations",
    "production_activation"
  ],
  "properties": {
    "schema": {
      "const": "kaliv-consciousness-core/world-state/v1"
    },
    "world_id": {
      "type": "string",
      "pattern": "^world-[a-f0-9]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "observations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "subject_ref",
          "proposition",
          "confidence",
          "epistemic_status",
          "source_refs"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^obs-[a-f0-9]{32}$"
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "proposition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "epistemic_status": {
            "enum": [
              "observed",
              "reported",
              "inferred",
              "predicted"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "production_activation": {
      "const": false
    }
  }
}
