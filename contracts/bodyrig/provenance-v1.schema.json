{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelrig.local/contracts/bodyrig/provenance-v1.schema.json",
  "title": "ModelRig Body Package Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "created_at", "source", "synthetic_avatar", "pipeline"],
  "properties": {
    "format": {"const": "modelrig-body-provenance"},
    "version": {"const": 1},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count"],
      "properties": {
        "kind": {"const": "user-supplied-local-media"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "synthetic_avatar": {"const": true},
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "adapter", "revision"],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9_-]+$"
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._/+:-]+$"
          }
        }
      }
    }
  }
}
